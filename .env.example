# Copy to .env (gitignored) and fill. The whole local→cloud difference is in this file.
# LOCAL DEFAULT: no services needed — the foundry uses a real embedded SQLite DB + queue.

# Model route (optional offline; required for live measurement/generation).
OLLAMA_API_KEY=
OH_LLM_BASE_URL=https://ollama.com/v1
OH_LLM_MODEL=batiai/gemma4-e2b:q4
OH_CHAT_MODEL=glm-5.2
OH_PRIMITIVE_RESEARCH_MODEL=glm-5.2
OH_PRIMITIVE_CODE_MODEL=kimi-k2.7-code
OH_EMBED_MODEL=nomic-embed-text

# NVIDIA Build (integrate.api.nvidia.com/v1) — OpenAI-compatible hosted lane; serves GLM 5.2.
# from_env() resolves this FIRST, so setting the key makes NVIDIA Build the primary foundry chat lane.
NVIDIA_API_KEY=
# OH_NVIDIA_CHAT_MODEL=z-ai/glm-5.2    # NVIDIA-scoped model id (default z-ai/glm-5.2; NOT the Ollama tag)

# Persistence + queue — LOCAL (sqlite; runnable now, no Docker):
OH_STORE_PATH=dist/foundry-store.sqlite
OH_QUEUE_PATH=dist/foundry-queue.sqlite

# CLOUD / docker-compose — switch to managed services by setting these (uncomment):
# DATABASE_URL=postgresql://ohh:ohh@localhost:5432/ohh
# REDIS_URL=redis://localhost:6379/0
# FOUNDRY_QUEUE_KEY=ohh:foundry:jobs

# ---- Deploy portability seams (added 2026-06-11; defaults = local plane, unset = unchanged) ----
# Container deploys set these; locally leave unset. Single sources: ports come from
# architecture/local_service_registry.json; cloud values are EMITTED by
# scripts/deploy/generate_provider_configs.py from architecture/deploy_topology.json.
# OH_BIND_HOST=0.0.0.0                 # servers bind 127.0.0.1 unless set (containers need 0.0.0.0)
# OH_SEAM_IDENTITY_BASE=               # showcase proxy → identity   (fly: http://aidr-identity.internal:9410)
# OH_SEAM_REGISTRY_BASE=               # showcase proxy → registry plane
# OH_SEAM_ANALYTICS_BASE=              # showcase proxy → events/analytics
# OH_SEAM_TELEON_RUNTIME_BASE=         # showcase proxy → teleon runtime
# OH_SEAM_LIVEOPS_BASE=                # showcase proxy → baltor live-ops backend
# AIDR_IDENTITY_BASE=                  # registry + teleon runtime → identity (k8s: http://identity:9410)
# AIDR_REGISTRY_BASE=                  # provisioning CLI → registry plane

# ---- Fly worker controller (scripts/deploy/fly_worker_controller.py; cloud role only) ----
# FLY_API_TOKEN=                       # deploy-scoped token for the worker app (fly tokens create)
# FLY_WORKER_APP=aidr-worker           # default derived from deploy_topology fly.app_prefix
# FLY_MACHINES_API=https://api.machines.dev   # on Fly: http://_api.internal:4280
# FLY_WORKER_IMAGE=                    # image for NEW machines (default: learned from the pool)
# FLY_CONTROLLER_RECEIPTS=             # optional JSONL receipts file (stdout always)

# ---- Teleon zero-op launch (co-resident runner in the teleon-runtime app) ----
# OH_TELEON_AUTO_LAUNCH=1              # promoted capabilities auto-launch on Fly Machines
#                                     # (OFF unless set to 1 AND FLY_API_TOKEN present; the
#                                     # runner is co-resident — same image + registry volume)

# ---- Taedri server administration (see docs/TAEDRI-GO-LIVE-RUNBOOK.md) ----
# TAEDRI_ADMIN_KEY=                    # administrator password for taedri.fly.dev /v1/admin/* (add primitives,
#                                      # rebuild search index). Lives as a Fly app secret; legacy name
#                                      # OH_SAAS_OWNER_KEY still accepted by the server.

# ---- Stripe payments (taedri gateway; see docs/TAEDRI-GO-LIVE-RUNBOOK.md) ----
# Deployment secrets, NOT local env: set via `gh secret set <NAME> --repo aidonerightcorp/taedri` then run
# the sync-fly-secrets workflow. Listed here so the canonical NAMES live in one place (values never in git).
# STRIPE_API_KEY=                      # sk_test_… first, sk_live_… when ready (Stripe -> Developers -> API keys)
# STRIPE_PRICE_ID_PRO=                 # price_… for the Capability Pro recurring price
# STRIPE_WEBHOOK_SECRET=               # whsec_… for the /v1/billing/webhook endpoint

# Cloudflare BYO compute (Workers AI live dispatch). Paste your real values to enable live runs.
# Token: Cloudflare dashboard -> My Profile -> API Tokens -> Workers AI (Read+Run). Account ID: Workers & Pages overview.
# For taedri.dev DNS automation the token also needs Zone:Read + DNS:Edit on the taedri.dev zone (runbook §3).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
