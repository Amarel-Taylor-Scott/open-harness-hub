{
  "version": "0.1.0",
  "updated": "2026-06-22",
  "principle": "STANDARDIZED objects passed between components (the Haystack/LlamaIndex typed-I/O pattern, grounded in our shared-I/O spine): each tool-plane declares the object TYPE it CONSUMES + PRODUCES, drawn from one type vocabulary. The compiler validates that a DAG edge connects compatible types (producer.produces ∩ consumer.consumes) BEFORE running — catching mismatches at compile time, like Haystack/Langflow. Large payloads pass as a ResourceRef (a typed POINTER), never a blob. serves_truth=false.",
  "serves_truth": false,
  "type_vocabulary": ["bytes", "image", "audio", "document", "text", "text_chunks", "table", "record", "fields", "entities", "vector", "query", "ranked_docs", "sources", "html", "statement_pair", "features", "label", "series", "forecast", "diff", "validated_record", "code"],
  "note": "any object > inline-size is passed as a ResourceRef pointer (schemas/resources/) — components receive the ref, resolve on read; logged as an OpenLineage Dataset reference, never the blob.",
  "planes": {
    "ocr": {"consumes": ["bytes", "image", "document"], "produces": ["text"]},
    "data_extraction": {"consumes": ["bytes", "document"], "produces": ["text", "table", "record"]},
    "field_parsing": {"consumes": ["text"], "produces": ["fields"]},
    "ner": {"consumes": ["text"], "produces": ["entities"]},
    "embedding": {"consumes": ["text", "text_chunks"], "produces": ["vector"]},
    "vector_store": {"consumes": ["vector", "query"], "produces": ["ranked_docs"]},
    "reranker": {"consumes": ["query", "ranked_docs"], "produces": ["ranked_docs"]},
    "search": {"consumes": ["query"], "produces": ["sources", "text"]},
    "browser": {"consumes": ["query", "sources"], "produces": ["html", "text"]},
    "social_scrape": {"consumes": ["query"], "produces": ["record", "text"]},
    "entity_enrichment": {"consumes": ["record", "fields"], "produces": ["record"]},
    "stance_nli": {"consumes": ["statement_pair"], "produces": ["label"]},
    "classical_ml": {"consumes": ["features", "text"], "produces": ["label"]},
    "time_series": {"consumes": ["series"], "produces": ["forecast", "label"]},
    "fuzzy_matching": {"consumes": ["record", "text"], "produces": ["record"]},
    "diff_compare": {"consumes": ["record", "text"], "produces": ["diff"]},
    "validation": {"consumes": ["record", "fields"], "produces": ["validated_record"]},
    "parsing_grammar": {"consumes": ["text", "code"], "produces": ["record", "code"]},
    "templating": {"consumes": ["record"], "produces": ["code", "text"]},
    "constraint_solver": {"consumes": ["record"], "produces": ["record"]},
    "mt": {"consumes": ["text"], "produces": ["text"]},
    "asr": {"consumes": ["audio"], "produces": ["text"]},
    "tts": {"consumes": ["text"], "produces": ["audio"]},
    "llm": {"consumes": ["text", "record"], "produces": ["text", "record", "fields", "label"]}
  }
}
