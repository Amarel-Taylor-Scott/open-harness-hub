{
  "version": "0.1.0",
  "updated": "2026-06-21",
  "principle": "Web browsing is a COMPOSED stack = a browser/automation tool + driving LOGIC components + a (vision/grounding) MODEL. The research descent selects the cheapest stack that gets the needed detail within guardrails. This registry holds the OPTIONS the descent + the LLM-driven browser driver (_repos/teleon/backend/src/teleon/research/llm_browser.py) choose from. It TARGETS >=20 browsers + >=100 driving components/models; it is SEEDED with real, license-classified entries and the coverage GAP to those targets is COMPUTED + filled by scripts/repo_intake_strategize.py + the discovery channel (no hand-typed filler). serves_truth=false; discovery!=trust.",
  "serves_truth": false,
  "targets": {
    "browsers": 20,
    "driving_components": 100
  },
  "license_discipline": "single source _repos/openhubforai/backend/src/openhubforai/licenses.classify_license \u2014 permissive => vendorable; copyleft/noncommercial/unstated => technique-only (study clean-room behind a port, never vendor the code)",
  "governance": "stealth / anti-bot / captcha / proxy entries are CATALOGED (they exist) but GOVERNED: the research_guardrail_policy still refuses login-walled hosts + honors robots/ToS; these are restricted to AUTHORIZED testing and DEFAULT to refuse for ToS-violating scraping. captcha_policy REFUSES solving + escalates to the owner / official API.",
  "coverage_note": "browsers target is met by the seed; driving_components is intentionally a partial real seed (no filler) \u2014 the gap to 100 is surfaced by check_web_browsing_stack_registry.py and filled by intake/discovery over time.",
  "capabilities_legend": [
    "js_render",
    "interaction",
    "dom",
    "vision",
    "deep_detail",
    "network_intercept",
    "crawl",
    "structured",
    "stealth"
  ],
