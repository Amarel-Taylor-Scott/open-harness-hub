      "template_path": "templates/worker/claim_loop/template.json",
      "output_paths": ["scripts/{{worker_name}}_worker.py", "scripts/check_{{worker_name}}_worker.py", "docs/runtime/{{worker_name}}-worker.md"],
      "variables": ["worker_name", "queue_name", "title", "owner"],
      "required_commands_after_generation": ["python3 scripts/check_{{worker_name}}_worker.py --self-test"],
