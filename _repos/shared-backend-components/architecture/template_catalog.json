      "standard_id": "standard.contract_schema",
      "template_path": "templates/contract/schema/template.json",
      "output_paths": ["schemas/{{area}}/{{contract_name}}.json", "scripts/check_{{contract_name}}_schema.py", "docs/contracts/{{contract_name}}.md"],
      "variables": ["area", "contract_name", "title", "owner"],
      "required_commands_after_generation": ["python3 scripts/check_{{contract_name}}_schema.py --self-test"],
