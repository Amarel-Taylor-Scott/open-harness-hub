      "standard_id": "standard.artifact_object",
      "template_path": "templates/artifact/object/template.json",
      "output_paths": ["scripts/artifacts/{{artifact_name}}.py", "scripts/check_{{artifact_name}}_artifact.py", "docs/artifacts/{{artifact_name}}.md"],
      "variables": ["artifact_name", "artifact_type", "title", "owner"],
      "required_commands_after_generation": ["python3 scripts/check_{{artifact_name}}_artifact.py --self-test"],
      "required_registry_updates": ["architecture/contract_registry.json#artifact_types += {{artifact_type}}"],
      "required_docs": ["docs/artifacts/{{artifact_name}}.md"],
      "required_proofs": ["scripts/check_{{artifact_name}}_artifact.py"],
