{
  "version": "1.0.0",
  "note": "Component templates for the Baltor Context Engine factory. A template is a manifest + a files/ tree of {{variable}} placeholders that scripts/generate_from_template.py renders into a NEW component conforming to a standard in standard_catalog.json. The 7 'active' templates are fully built (real template_path with files/); the rest are 'candidate' with a planned template_path and the standard they will target. This catalog is the single source for which templates exist; generate_from_template.py reads it. status_enum gates whether a template can be generated.",
  "status_enum": ["candidate", "active", "deprecated"],
  "templates": [
    {
      "template_id": "ingestion.source_adapter",
      "standard_id": "standard.source_adapter",
      "template_path": "templates/ingestion/source_adapter/template.json",
      "output_paths": ["scripts/ingest/{{source_family}}.py", "scripts/check_{{source_family}}_adapter.py", "docs/ingestion/{{source_family}}.md"],
      "variables": ["source_family", "source_type", "parser_provider", "title", "owner"],
      "required_commands_after_generation": [
        "python3 scripts/check_{{source_family}}_adapter.py --self-test",
        "python3 scripts/validate.py scripts/ingest/{{source_family}}.py"
      ],
      "required_registry_updates": [
        "architecture/contract_registry.json#source_types += {{source_type}}",
        "architecture/section_maturity_matrix.json sections += {{source_family}} (category ingestion)"
      ],
      "required_docs": ["docs/ingestion/{{source_family}}.md"],
      "required_proofs": ["scripts/check_{{source_family}}_adapter.py"],
      "status": "active"
    },
    {
      "template_id": "worker.command_handler",
      "standard_id": "standard.durable_command",
      "template_path": "templates/worker/command_handler/template.json",
      "output_paths": ["scripts/handlers/{{handler_name}}.py", "scripts/check_{{handler_name}}_handler.py", "docs/runtime/{{handler_name}}.md"],
      "variables": ["handler_name", "command_type", "queue_name", "title", "owner"],
      "required_commands_after_generation": [
        "python3 scripts/check_{{handler_name}}_handler.py --self-test"
      ],
      "required_registry_updates": [
        "architecture/contract_registry.json#command_types += {{command_type}}",
        "architecture/contract_registry.json#queue_names += {{queue_name}}"
      ],
      "required_docs": ["docs/runtime/{{handler_name}}.md"],
      "required_proofs": ["scripts/check_{{handler_name}}_handler.py"],
      "status": "active"
    },
    {
      "template_id": "api.projection_route",
      "standard_id": "standard.api_projection",
      "template_path": "templates/api/projection_route/template.json",
      "output_paths": ["scripts/api_{{area}}_handler.py", "scripts/check_{{area}}_api.py", "docs/api/{{area}}.md"],
      "variables": ["area", "route_path", "returns_contract", "title", "owner"],
      "required_commands_after_generation": [
        "python3 scripts/check_{{area}}_api.py --self-test"
      ],
      "required_registry_updates": [
        "architecture/contract_registry.json#api_routes += GET {{route_path}} (projection_only:true, owner scripts/api_{{area}}_handler.py)"
      ],
      "required_docs": ["docs/api/{{area}}.md"],
      "required_proofs": ["scripts/check_{{area}}_api.py"],
      "status": "active"
    },
    {
      "template_id": "ui.projection_page",
      "standard_id": "standard.ui_projection",
      "template_path": "templates/ui/projection_page/template.json",
      "output_paths": ["_repos/baltor/frontend/{{page}}.html", "scripts/check_{{page}}_ui.py", "docs/ui/{{page}}.md"],
      "variables": ["page", "api_endpoint", "title", "owner"],
      "required_commands_after_generation": [
        "python3 scripts/check_{{page}}_ui.py --self-test"
      ],
      "required_registry_updates": [
        "architecture/section_maturity_matrix.json ui_pages += _repos/baltor/frontend/{{page}}.html"
      ],
      "required_docs": ["docs/ui/{{page}}.md"],
      "required_proofs": ["scripts/check_{{page}}_ui.py"],
      "status": "active"
    },
    {
      "template_id": "provider.adapter",
      "standard_id": "standard.provider_adapter",
      "template_path": "templates/provider/adapter/template.json",
      "output_paths": ["scripts/adapters/{{adapter_name}}.py", "scripts/check_{{adapter_name}}_adapter.py", "docs/adapters/{{adapter_name}}.md"],
      "variables": ["adapter_name", "port_name", "capability", "title", "owner"],
      "required_commands_after_generation": [
        "python3 scripts/check_{{adapter_name}}_adapter.py --self-test"
      ],
      "required_registry_updates": [
        "architecture/external_capability_catalog.json += {{capability}} ({{adapter_name}})"
      ],
      "required_docs": ["docs/adapters/{{adapter_name}}.md"],
      "required_proofs": ["scripts/check_{{adapter_name}}_adapter.py"],
      "status": "active"
    },
    {
      "template_id": "proof.self_test",
      "standard_id": "standard.proof_script",
      "template_path": "templates/proof/self_test/template.json",
      "output_paths": ["scripts/check_{{proof_name}}.py"],
      "variables": ["proof_name", "title", "owner", "subject_module"],
      "required_commands_after_generation": [
        "python3 scripts/check_{{proof_name}}.py --self-test"
      ],
      "required_registry_updates": [
        "scripts/baltor_flywheel.py PROOF_MODULES += (scripts/check_{{proof_name}}.py, {{proof_name}})"
