      "required_commands_after_generation": ["python3 scripts/check_{{source_family}}_sync.py --self-test"],
      "required_registry_updates": ["architecture/contract_registry.json#queue_names += ingest.{{source_family}}"],
      "required_docs": ["docs/ingestion/{{source_family}}-sync.md"],
      "required_proofs": ["scripts/check_{{source_family}}_sync.py"],
      "status": "candidate"
    },
    {
