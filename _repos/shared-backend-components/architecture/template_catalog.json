      "template_path": "templates/optimization/candidate/template.json",
      "output_paths": ["scripts/runtime/optimizers/{{optimizer_name}}.py", "scripts/check_{{optimizer_name}}_optimizer.py", "docs/runtime/{{optimizer_name}}-optimizer.md"],
