{
  "version": "1.0",
  "note": "The Pattern Registry. One entry per canonical repeated SHAPE in the Baltor monorepo. A pattern is the named, governed answer to a recurring build problem: when the same shape is built twice it becomes a 'standard'; a 'standard' gets a template; a 'standard' becomes 'enforced' once a proof + an anti-bypass check exist; new instances either follow it or carry a recorded waiver. This is a META layer over existing code -- it does NOT introduce a runtime/bus/worker/ledger/gateway/parser; it points at the working implementations that already exist. Every detected_examples path is REAL (verified on disk at authoring time). Detector + grading: scripts/pattern_miner.py. Per-pattern roll-up: architecture/pattern_maturity_matrix.json. Loop + governance: docs/standards/pattern-system.md.",
  "maturity_enum": ["candidate", "standard", "enforced", "deprecated"],
  "maturity_grading_rule": "candidate = shape described or built once; standard = a real implemented example + a passing proof; enforced = standard + an anti-bypass/CI check that fails on a non-conforming new instance; deprecated = superseded, kept only to flag old instances.",
  "patterns": [
    {
      "pattern_id": "source_adapter_pattern",
      "category": "pre_llm_ingestion",
      "name": "Source Adapter",
      "description": "The ONLY thing that touches a raw upstream source. Turns a fetched object into governed SourceArtifacts carrying tenant_id/source_id/source_version/content_hash/scope/authority/lineage and nothing else. Never writes served facts, never bypasses the ledger.",
      "detected_examples": [
        "_repos/baltor/backend/src/baltor/ports/source_adapter.py",
        "scripts/ingest/source_adapters.py",
        "_repos/baltor/backend/src/baltor/adapters/source/folder_batch.py",
        "_repos/baltor/backend/src/baltor/adapters/source/markdown_folder.py"
      ],
      "owner_folder": "_repos/baltor/backend/src/baltor/adapters/source",
      "required_contracts": ["SourceArtifact", "FetchRequest"],
      "required_ports": ["SourceAdapterPort"],
      "required_adapters": ["one concrete adapter per source_class"],
      "required_registries": ["architecture/ingestion_connector_catalog.json", "architecture/external_capability_catalog.json#scraping_manager"],
      "required_proofs": ["scripts/check_multi_source_ingestion.py", "scripts/check_ingest_folder_batch.py"],
      "required_docs": ["_repos/baltor/context/standards/adapter-contract.md"],
      "template_ids": [],
      "anti_patterns": ["raw_network_import", "adapter writing served facts", "adapter bypassing the artifact ledger"],
      "maturity": "standard",
      "waiver_allowed": false,
      "done_when": ["port declared", "concrete adapter per source_class", "produces only SourceArtifacts", "registered in the connector catalog", "proof passes"]
    },
