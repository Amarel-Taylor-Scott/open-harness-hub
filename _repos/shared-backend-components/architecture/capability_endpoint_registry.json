{
  "version": "CapabilityEndpointRegistry",
  "purpose": "Many providers can serve the SAME capability (e.g. WHOIS via RDAP, a paid API, or a library). This registry maps a capability_slot to its interchangeable PROVIDER ENDPOINTS, each with the signals Teleon selects on — cost, latency, reliability, license, and egress domain. The objective layer picks the best endpoint per the tenant's priority (fastest / cheapest / most reliable); the org guardrail policy filters disallowed endpoints (license/domain/egress) BEFORE selection (safety beats objective). Declared figures are typical-case priors; the RunLedger refines them from observed calls. Data only — read by _repos/teleon/backend/src/teleon/endpoints; never names a src.baltor symbol; nothing here serves truth.",
  "cost_units": "relative per-call units (0.0 = free tier / no marginal cost)",
  "endpoints": {
    "whois-domain-lookup": [
      {"endpoint_id": "rdap-iana", "provider": "IANA RDAP bootstrap", "kind": "rdap", "access": "free",
       "cost": 0.0, "latency_ms": 250, "reliability": 0.90, "license": "public", "egress_domain": "rdap.org",
       "region": "global", "notes": "official structured RDAP; free + fast, but coverage is incomplete across some ccTLDs/registrars (~90%)"},
      {"endpoint_id": "python-whois-lib", "provider": "python-whois (library)", "kind": "library", "access": "free",
       "cost": 0.0, "latency_ms": 1200, "reliability": 0.82, "license": "MIT", "egress_domain": "port43-whois",
       "region": "global", "notes": "parses free-text WHOIS; brittle across TLD formats"},
      {"endpoint_id": "whoisxmlapi", "provider": "WhoisXML API", "kind": "rest_api", "access": "paid",
       "cost": 0.004, "latency_ms": 350, "reliability": 0.99, "license": "commercial", "egress_domain": "whoisxmlapi.com",
       "region": "us", "notes": "high-reliability commercial API; API key required"}
    ],
    "geocode-address": [
      {"endpoint_id": "nominatim-osm", "provider": "OpenStreetMap Nominatim", "kind": "rest_api", "access": "free",
       "cost": 0.0, "latency_ms": 600, "reliability": 0.9, "license": "ODbL-1.0", "egress_domain": "nominatim.openstreetmap.org",
       "region": "global", "notes": "free; heavy rate limits + usage policy"},
      {"endpoint_id": "census-geocoder", "provider": "US Census Geocoder", "kind": "rest_api", "access": "free",
       "cost": 0.0, "latency_ms": 500, "reliability": 0.95, "license": "public", "egress_domain": "geocoding.geo.census.gov",
       "region": "us", "notes": "official, free, US addresses only"},
      {"endpoint_id": "google-geocoding", "provider": "Google Geocoding API", "kind": "rest_api", "access": "paid",
       "cost": 0.005, "latency_ms": 120, "reliability": 0.995, "license": "commercial", "egress_domain": "maps.googleapis.com",
       "region": "global", "notes": "fastest + most reliable; paid + ToS restrictions on storage"},
      {"endpoint_id": "mapbox-geocoding", "provider": "Mapbox Geocoding", "kind": "rest_api", "access": "paid",
       "cost": 0.004, "latency_ms": 160, "reliability": 0.99, "license": "commercial", "egress_domain": "api.mapbox.com",
       "region": "global", "notes": "paid; free tier with attribution"}
    ],
    "stock-price-quote": [
      {"endpoint_id": "alphavantage", "provider": "Alpha Vantage", "kind": "rest_api", "access": "api_key",
       "cost": 0.0, "latency_ms": 700, "reliability": 0.9, "license": "commercial", "egress_domain": "alphavantage.co",
       "region": "us", "notes": "free key; 5 req/min limit"},
      {"endpoint_id": "finnhub", "provider": "Finnhub", "kind": "rest_api", "access": "api_key",
       "cost": 0.0, "latency_ms": 300, "reliability": 0.95, "license": "commercial", "egress_domain": "finnhub.io",
       "region": "us", "notes": "free tier; faster"},
      {"endpoint_id": "polygon-io", "provider": "Polygon.io", "kind": "rest_api", "access": "paid",
       "cost": 0.006, "latency_ms": 90, "reliability": 0.995, "license": "commercial", "egress_domain": "polygon.io",
       "region": "us", "notes": "lowest latency, highest reliability; paid"},
      {"endpoint_id": "yahoo-finance-unofficial", "provider": "Yahoo Finance (unofficial)", "kind": "library", "access": "free",
       "cost": 0.0, "latency_ms": 800, "reliability": 0.78, "license": "unknown", "egress_domain": "query1.finance.yahoo.com",
       "region": "us", "notes": "unofficial endpoint; ToS-gray, breaks without notice"}
    ],
    "weather-current": [
      {"endpoint_id": "open-meteo", "provider": "Open-Meteo", "kind": "rest_api", "access": "free",
       "cost": 0.0, "latency_ms": 150, "reliability": 0.97, "license": "CC-BY-4.0", "egress_domain": "api.open-meteo.com",
       "region": "global", "notes": "free, no key, fast; non-commercial free tier"},
      {"endpoint_id": "nws-api", "provider": "US National Weather Service", "kind": "rest_api", "access": "free",
       "cost": 0.0, "latency_ms": 400, "reliability": 0.96, "license": "public", "egress_domain": "api.weather.gov",
       "region": "us", "notes": "official, free, US only"},
      {"endpoint_id": "openweather", "provider": "OpenWeather", "kind": "rest_api", "access": "api_key",
       "cost": 0.002, "latency_ms": 220, "reliability": 0.98, "license": "commercial", "egress_domain": "api.openweathermap.org",
       "region": "global", "notes": "free tier + paid; global coverage"}
    ]
  }
}
