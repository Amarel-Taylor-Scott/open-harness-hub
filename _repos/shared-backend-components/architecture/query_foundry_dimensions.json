  "search_operators": {
    "null_weight": 0.45,
    "notes": "Source-TYPE targeting operators (Google-dork-style: filetype/site/inurl/intitle + negative junk filters). The WebSearch backend may not honor raw operator syntax; the research agent applies the INTENT \u2014 literal operator where supported, else PREFER matching results (a PDF, a github repo, a docs URL). Stored structured on the row; yield-per-operator is tracked so the foundry learns which operators surface the richest primitive/template sources. Not for finding exposed secrets/systems \u2014 purely technical-source precision.",
    "values": [
      {
        "op": "filetype:pdf",
        "targets": "papers, whitepapers, standards, textbook chapters"
      },
      {
        "op": "site:github.com",
        "targets": "real implementations, READMEs, workflow YAML"
      },
      {
        "op": "site:*.edu",
        "targets": "academic course notes, lecture architectures"
      },
      {
        "op": "intitle:\"reference architecture\"",
        "targets": "vendor/cloud reference designs"
      },
      {
        "op": "intitle:runbook OR intitle:playbook",
        "targets": "operational procedures, incident chains"
      },
      {
        "op": "inurl:docs",
        "targets": "product/framework documentation"
      },
      {
        "op": "site:stackoverflow.com",
        "targets": "recurring problem->solution patterns"
      },
      {
        "op": "filetype:md site:github.com",
        "targets": "specs, ADRs, design docs in repos"
      },
      {
        "op": "intitle:\"design patterns\" OR intitle:\"pattern language\"",
        "targets": "pattern catalogs"
      },
      {
        "op": "inurl:wiki",
        "targets": "knowledge-base process descriptions"
      },
      {
        "op": "filetype:yaml OR filetype:yml",
        "targets": "workflow/pipeline/CI definitions"
      },
      {
        "op": "-site:pinterest.com -site:quora.com",
        "targets": "junk-filter (negative operator)"
      }
    ]
  }
