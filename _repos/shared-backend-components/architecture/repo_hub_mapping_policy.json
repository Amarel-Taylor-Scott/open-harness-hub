{
  "version": "1.0",
  "note": "keyword\u2192hub mapping (deterministic-first). LLM classification is advisory only and routes through the Inference Gateway; it cannot activate a repo.",
  "rules": [
    {
      "any": [
        "markdown",
        "convert",
        "ingest",
        "document",
        "ocr"
      ],
      "hubs": [
        "opentoolshub",
        "opencontexthub"
      ]
    },
    {
      "any": [
        "compress",
        "token",
        "rag",
        "headroom"
      ],
      "hubs": [
        "opentoolshub",
        "openhubforai",
        "teleon"
      ]
    },
    {
      "any": [
        "skill",
        "playbook",
        "workflow",
        "instinct",
        "taste",
        "judgment"
      ],
      "hubs": [
        "openskillshub"
      ]
    },
    {
      "any": [
        "eval",
        "rubric",
        "harness",
        "benchmark",
        "conformance",
        "fixture"
      ],
      "hubs": [
        "openhubforai"
      ]
    },
    {
      "any": [
        "memory",
        "recall"
      ],
      "hubs": [
        "opentoolshub",
        "baltor"
      ]
    },
    {
      "any": [
        "graph",
        "knowledge-graph",
        "code-graph",
        "context"
      ],
      "hubs": [
        "opencontexthub",
        "opentoolshub"
      ]
    },
    {
      "any": [
        "mcp",
        "cli",
        "api",
        "adapter",
        "worker",
        "tool"
      ],
      "hubs": [
        "opentoolshub"
      ]
    },
    {
      "any": [
        "template",
        "scaffold",
        "generator",
        "starter"
      ],
      "hubs": [
        "shared-template-registry"
      ]
    },
    {
      "any": [
        "runtime",
        "coding-agent",
        "agent",
        "self-evolv",
        "capability"
      ],
      "hubs": [
        "teleon"
      ]
    },
    {
      "any": [
        "video",
        "voice",
        "tts",
        "speech",
        "media",
        "image"
      ],
      "hubs": [
        "opentoolshub"
      ],
      "priority": "low"
    }
  ]
}