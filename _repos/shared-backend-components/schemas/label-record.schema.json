{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/label-record.schema.json",
  "title": "Label record",
  "description": "Hierarchical, schema.org-style, custom, or generated label assigned to a catalog component, normalized object, source record, or entity.",
  "type": "object",
  "required": ["label_id", "label_set", "label", "subject_id"],
  "properties": {
    "label_id": { "type": "string" },
    "label_set": {
      "type": "string",
      "enum": ["catalog", "hierarchical", "schema_org", "tenant_custom", "generated", "curated"]
    },
    "label": { "type": "string" },
    "path": { "type": "string" },
    "subject_id": { "type": "string" },
    "subject_type": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "assigned_by": { "type": "string" },
    "assignment_method": {
      "type": "string",
      "enum": ["deterministic", "curator", "publisher", "tenant", "model", "imported"]
    },
    "model_route_id": { "type": "string" },
    "provenance": { "type": "object" },
    "state": { "$ref": "_common.schema.json#/$defs/objectState" },
    "state_history": {
      "type": "array",
      "items": { "$ref": "_common.schema.json#/$defs/stateEvent" }
    },
    "priority_signals": { "$ref": "_common.schema.json#/$defs/prioritySignals" },
    "review_status": { "type": "string" }
  }
}
