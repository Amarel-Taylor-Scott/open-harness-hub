{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidoneright.dev/schemas/api_interface_primitive.schema.json",
  "title": "ApiInterfacePrimitive",
  "description": "An API endpoint as a GOVERNED interface primitive: the semantic capability + the actual endpoint binding + side-effect/idempotency/retry/auth/cost policy + provenance. An endpoint is source material; a primitive is the endpoint wrapped with schema validation, side-effect metadata, and tests. candidate; serves_truth=false.",
  "type": "object",
  "required": [
    "primitive_id", "record_type", "provider", "service", "operation_id", "method", "path_template",
    "semantic_action", "input_schema", "output_schema", "auth", "side_effects", "idempotency",
    "execution_model", "determinism_level", "permission_manifest", "risk_tier", "lifecycle_stage",
    "needs_executor", "provenance", "candidate", "serves_truth"
  ],
  "properties": {
    "primitive_id": {"type": "string"},
    "record_type": {"const": "api_interface_primitive"},
    "provider": {"type": "string"},
    "service": {"type": "string"},
    "operation_id": {"type": "string"},
    "method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "GRAPHQL", "EVENT", "TOOL"]},
    "path_template": {"type": "string"},
    "semantic_action": {"enum": ["read", "search", "classify", "standardize", "generate", "create",
                                 "update", "delete", "submit", "post", "reconcile"]},
    "resource_type": {"type": ["string", "null"]},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "error_schema": {"type": ["object", "null"]},
    "auth": {"type": "object", "required": ["type", "required_scopes"]},
    "side_effects": {"type": "object", "required": ["level", "requires_confirmation"]},
    "idempotency": {"type": "object", "required": ["supported", "safe_to_retry"]},
    "pagination": {"type": ["object", "null"]},
    "rate_limits": {"type": ["object", "null"]},
    "cost_model": {"type": ["object", "null"]},
    "reliability_policy": {"type": ["object", "null"]},
    "bundle": {"type": "array", "items": {"type": "string"}},
    "execution_model": {"const": "external_tool"},
    "determinism_level": {"type": "string"},
    "permission_manifest": {"type": "object"},
    "risk_tier": {"enum": ["safe", "low risk", "review required", "high risk", "quarantined"]},
    "lifecycle_stage": {"type": "string"},
    "needs_executor": {"type": "boolean"},
    "compilation_targets": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "required": ["spec_hash"]},
    "candidate": {"const": true},
    "serves_truth": {"const": false}
  }
}
