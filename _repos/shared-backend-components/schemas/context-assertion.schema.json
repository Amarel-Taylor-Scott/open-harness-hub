{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/context-assertion.schema.json",
  "title": "Context assertion",
  "description": "Source-linked assertion about a context object. Assertions let flexible attributes, claims, and relationship-like statements carry evidence, confidence, validity windows, and lineage.",
  "type": "object",
  "required": ["kind", "context_assertion_id", "subject_id", "predicate", "created_at"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "baltor.context-assertion"
    },
    "context_assertion_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "value": {},
    "value_type": {
      "type": "string",
      "enum": ["relationship", "string", "number", "boolean", "object", "array", "dimension_value", "claim", "custom"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asserted_by": {
      "type": "object",
      "additionalProperties": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
