{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/priority-policy.schema.json",
  "title": "Priority policy",
  "description": "Declarative rule set for turning findings into queued work with a lane, priority, cadence, and retry policy.",
  "type": "object",
  "required": ["policy_id", "version", "rules"],
  "properties": {
    "policy_id": { "type": "string" },
    "version": { "$ref": "_common.schema.json#/$defs/semver" },
    "description": { "type": "string" },
    "default_lane": { "$ref": "_common.schema.json#/$defs/queueLane" },
    "default_priority": { "$ref": "_common.schema.json#/$defs/queuePriority" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "when", "enqueue"],
        "properties": {
          "rule_id": { "type": "string" },
          "description": { "type": "string" },
          "when": {
            "type": "object",
            "description": "Simple condition map evaluated by the policy engine. Keys should be stable record fields or priority_signals paths."
          },
          "enqueue": {
            "type": "object",
            "required": ["task_type", "lane", "priority"],
            "properties": {
              "task_type": { "$ref": "_common.schema.json#/$defs/researchTaskType" },
              "lane": { "$ref": "_common.schema.json#/$defs/queueLane" },
              "priority": { "$ref": "_common.schema.json#/$defs/queuePriority" },
              "not_before_delay": { "type": "string" },
              "deadline_delay": { "type": "string" },
              "max_attempts": { "type": "integer", "minimum": 0 },
              "backoff": { "type": "string" },
              "dedupe_key_template": { "type": "string" },
              "reason_codes": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          },
          "score": {
            "type": "object",
            "description": "Optional weighted scoring hints for tie-breaking within a priority band.",
            "additionalProperties": { "type": "number" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
