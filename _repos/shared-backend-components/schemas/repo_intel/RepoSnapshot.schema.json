{
  "$id": "repo_intel/RepoSnapshot",
  "title": "RepoSnapshot",
  "type": "object",
  "additionalProperties": true,
  "description": "A point-in-time GitHub repo metadata snapshot. Weekly star-growth is computed from STORED snapshots (never a scraped delta). source_confidence flags owner_provided_unverified until live metadata confirms.",
