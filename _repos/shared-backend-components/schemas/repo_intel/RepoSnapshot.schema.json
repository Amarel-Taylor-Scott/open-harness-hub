    "repo_id",
    "full_name",
    "html_url",
    "stars_count",
    "collected_at",
    "source_method",
    "source_confidence",
    "raw_metadata_hash"
  ],
  "properties": {
    "repo_id": {},
    "full_name": {},
    "html_url": {},
    "clone_url": {},
    "default_branch": {},
    "description": {},
    "topics": {},
    "language_primary": {},
    "languages": {},
    "license": {},
    "stars_count": {},
    "forks_count": {},
    "open_issues_count": {},
    "watchers_count": {},
    "pushed_at": {},
    "created_at": {},
    "updated_at": {},
    "latest_release": {},
    "archived": {},
    "disabled": {},
    "private": {},
    "collected_at": {},
    "source_method": {},
    "source_confidence": {},
    "raw_metadata_hash": {}
  }
}