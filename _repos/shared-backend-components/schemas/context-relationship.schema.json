{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/context-relationship.schema.json",
  "title": "Context relationship",
  "description": "Typed, directional, source-backed, and time-aware edge between context objects, versions, or artifacts.",
  "type": "object",
  "required": ["kind", "context_relationship_id", "from_id", "to_id", "relationship_type", "created_at"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "baltor.context-relationship"
    },
    "context_relationship_id": {
      "type": "string"
    },
    "from_id": {
      "type": "string"
    },
    "to_id": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "CONTAINS",
        "PART_OF",
        "DERIVED_FROM",
        "CITES",
        "SUPPORTS",
        "CONTRADICTS",
        "SUPERSEDES",
        "MAY_SUPERSEDE",
        "DEFINES",
        "ALIAS_OF",
        "MENTIONS",
        "IMPLEMENTS",
        "FIXES",
        "DEPENDS_ON",
        "BLOCKS",
        "OWNED_BY",
        "APPROVED_BY",
        "APPLIES_TO",
        "GENERATED_BY",
        "OBSERVED_AT",
        "AFFECTS",
        "REQUIRES_REFRESH",
        "ACQUIRED",
        "MERGED_INTO",
        "SPLIT_FROM",
        "SPUN_OUT_FROM",
        "CURRENT_PARENT_OF",
        "FORMER_PARENT_OF",
        "CUSTOM"
      ]
    },
    "relationship_label": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_handles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ctx://"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
