{
  "$id": "observability/LineageFacet",
  "title": "LineageFacet",
  "description": "Baltor's normalized lineage record plus standards renderings (PROV-JSON, OpenLineage RunEvent) carrying governance facets, with a content hash for CDC. A read-only projection; emitting it never mutates canonical state.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string"},
    "activity": {"type": "string"},
    "occurred_at": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "agent": {"type": "string"},
    "governance": {"type": "object"},
    "renderings": {
      "type": "object",
      "description": "standards renderings keyed by name",
      "properties": {
        "prov": {"type": "object"},
        "openlineage": {"type": "object"}
      }
    },
    "content_hash": {"type": "string"}
  },
  "required": ["event_id", "activity", "occurred_at", "renderings", "content_hash"]
}
