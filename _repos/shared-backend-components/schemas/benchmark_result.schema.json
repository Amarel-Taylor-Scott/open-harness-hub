{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidoneright.dev/schemas/benchmark_result.schema.json",
  "title": "PrimitiveBenchmarkResult",
  "description": "One benchmark receipt for a primitive: correctness + determinism + amortized economics + latency + fallback + security-gate status. Makes primitive economics publishable and comparable to compiled-AI papers. candidate; serves_truth=false.",
  "type": "object",
  "required": [
    "record_type", "primitive_id", "benchmark_id", "baseline_name", "variant_name",
    "input_count", "oracle_pass_rate", "first_pass_rate", "semantic_entropy",
    "deterministic_replay_pass", "runtime_tokens", "baseline_runtime_tokens",
    "token_reduction_factor", "break_even_n", "break_even_n_true",
    "latency_p50_ms", "latency_p95_ms", "latency_p99_ms", "security_gate_status",
    "artifact_hash", "candidate", "serves_truth"
  ],
  "properties": {
    "record_type": {"const": "primitive_benchmark_result"},
    "run_id": {"type": ["string", "null"]},
    "commit_sha": {"type": ["string", "null"]},
    "primitive_id": {"type": "string"},
    "primitive_version": {"type": ["string", "null"]},
    "pack_id": {"type": ["string", "null"]},
    "benchmark_id": {"type": "string"},
    "baseline_name": {"type": "string"},
    "variant_name": {"type": "string"},
    "input_count": {"type": "integer", "minimum": 0},
    "oracle_pass_count": {"type": "integer", "minimum": 0},
    "oracle_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "first_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "repair_count": {"type": "integer", "minimum": 0},
    "fallback_count": {"type": "integer", "minimum": 0},
    "fallback_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "semantic_entropy": {"type": "number", "minimum": 0},
    "deterministic_replay_pass": {"type": "boolean"},
    "compile_tokens": {"type": ["integer", "null"]},
    "runtime_tokens": {"type": "integer", "minimum": 0},
    "baseline_runtime_tokens": {"type": ["integer", "null"]},
    "token_reduction_factor": {"type": ["number", "null"]},
    "compile_cost_usd": {"type": ["number", "null"]},
    "validation_cost_usd": {"type": ["number", "null"]},
    "runtime_cost_usd": {"type": ["number", "null"]},
    "baseline_runtime_cost_usd": {"type": ["number", "null"]},
    "break_even_n": {"type": ["number", "null"]},
    "break_even_n_true": {"type": ["number", "null"]},
    "latency_p50_ms": {"type": "number", "minimum": 0},
    "latency_p95_ms": {"type": "number", "minimum": 0},
    "latency_p99_ms": {"type": "number", "minimum": 0},
    "jitter_ms": {"type": ["number", "null"]},
    "deterministic_advantage": {"type": ["number", "null"]},
    "marginal_utility_status": {"type": ["string", "null"]},
    "security_gate_status": {"type": "string", "enum": ["pass", "fail", "quarantine", "skipped", "unknown"]},
    "artifact_hash": {"type": "string"},
    "proof_hash": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"]},
    "candidate": {"const": true},
    "serves_truth": {"const": false}
  }
}
