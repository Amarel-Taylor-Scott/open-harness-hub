{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/review-ticket.schema.json",
  "title": "Review ticket",
  "description": "Human or automated review queue item for risky, ambiguous, high-value, or publisher-owned objects.",
  "type": "object",
  "required": ["review_ticket_id", "review_type", "reason", "status"],
  "properties": {
    "review_ticket_id": { "type": "string" },
    "object_id": { "type": "string" },
    "source_record_id": { "type": "string" },
    "review_type": {
      "type": "string",
      "enum": ["curator", "domain_expert", "legal", "privacy", "safety", "publisher", "security", "quality", "cost"]
    },
    "reason": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["open", "in_review", "approved", "rejected", "needs_changes", "deferred"]
    },
    "state": { "$ref": "_common.schema.json#/$defs/objectState" },
    "state_history": {
      "type": "array",
      "items": { "$ref": "_common.schema.json#/$defs/stateEvent" }
    },
    "priority": { "$ref": "_common.schema.json#/$defs/queuePriority" },
    "priority_signals": { "$ref": "_common.schema.json#/$defs/prioritySignals" },
    "queue_policy": { "$ref": "_common.schema.json#/$defs/queuePolicy" },
    "assigned_to": { "type": "string" },
    "created_at": { "type": "string" },
    "resolved_at": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
