{
  "$id": "templates/TemplateArtifact",
  "title": "TemplateArtifact",
  "type": "object",
  "additionalProperties": true,
  "description": "A reusable STARTING-SHAPE template (infrastructure/inference/resource/api/ui/purpose-task/schema-object). Generates starting shapes; it is NOT a runtime, NOT proof, and never writes truth. Generated outputs are candidates until a harness/eval validates them. Carries numeric status/visibility codes + provenance; secret_refs only.",
