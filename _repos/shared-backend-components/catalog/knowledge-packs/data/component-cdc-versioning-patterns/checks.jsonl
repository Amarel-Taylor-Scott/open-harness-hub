{"id":"component-cdc/canonical-definition-hash","check_type":"hash_identity","description":"Compute definition hashes from canonical JSON with stable key ordering and compact separators so formatting changes do not create false component versions.","required_tables":["component_version","component_change_event"],"required_fields":["component_version.definition_hash","component_change_event.previous_definition_hash","component_change_event.new_definition_hash"],"failure_route":"hash_recomputed_review","review_queue":"component_change_review","index_kinds":["freshness","quality"]}
{"id":"component-cdc/source-content-hash","check_type":"source_refresh","description":"Track source content hashes separately from definition hashes so a source refresh can be detected even when the component wrapper has not changed.","required_tables":["source_record","normalized_object","component_candidate","component_change_event"],"required_fields":["source_record.content_hash","normalized_object.content_hash","component_candidate.content_hash","component_change_event.previous_content_hash","component_change_event.new_content_hash"],"failure_route":"source_refresh_review","review_queue":"source_governance_review","index_kinds":["freshness","graph"]}
{"id":"component-cdc/signed-publisher-event","check_type":"publisher_signature","description":"Preserve signature references on high-trust publisher updates so downstream pipelines can prefer signed public facts, verify revocation, and propagate changes.","required_tables":["component_change_event","source_record","review_ticket"],"required_fields":["component_change_event.signature_ref","component_change_event.actor_type","component_change_event.actor_ref","source_record.publisher"],"failure_route":"publisher_signature_review","review_queue":"publisher_identity_review","index_kinds":["facet","graph","freshness"]}
{"id":"component-cdc/version-review-routing","check_type":"review_gate","description":"Route updated, source-refreshed, and publisher-signed component changes to review before promotion when they affect volatile facts, safety-sensitive domains, or deployment behavior.","required_tables":["component_change_event","review_ticket","promotion_decision"],"required_fields":["component_change_event.change_type","component_change_event.changed_fields","review_ticket.review_type","review_ticket.reason"],"failure_route":"component_change_review","review_queue":"component_change_review","index_kinds":["quality","freshness"]}
{"id":"component-cdc/index-delta-emission","check_type":"index_update","description":"Emit freshness, keyword, graph, and quality index records for component changes so keyword search, vector search, graph search, and update propagation stay in sync.","required_tables":["component_change_event","index_record","index_delta"],"required_fields":["index_record.index_kind","index_record.subject_id","index_record.metadata","index_delta.operation"],"failure_route":"index_delta_replay","review_queue":"index_replay_review","index_kinds":["keyword","vector","graph","freshness","quality"]}
