# ---------------------------------------------------------------------------
# Open Harness Hub .gitignore
#
# Goal: never accidentally stage generated factory output, local reference
# clones, or OS/tooling cruft. Curated, published outputs are negated back in.
#
# Note: already-tracked files stay tracked regardless of these rules. To add a
# new file under an ignored path on purpose, use `git add -f <path>`.
# ---------------------------------------------------------------------------

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*~
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Primitive embedding index (regenerable build artifact: ~115MB .npy for 112K cards, rebuilt in ~2.3s
#     by scripts/build_primitive_embeddings.py --build; never commit the blob) ---
_repos/shared-backend-components/dist/primitive-embeddings/

# --- MkDocs build output ---
/site/

# --- Local reference repos ---
# Cloned for offline study only; NEVER republished (AGENTS.md hard rule).
# Tracked gitlink pointers remain; their working-tree contents stay out.
/_reference/
# repo_reference/: external repos cloned for offline study (incl. copyleft/unstated-license code).
# NEVER republished — only the tracked README + architecture/repo_reference_manifest.json record what's there.
/repo_reference/*
!/repo_reference/README.md

# --- Generated factory output (dist/) ---
# Ignored by default so daily run scratch (which can reach gigabytes) is never
# staged by accident. Curated, published emitter products are negated back in
# below. Keep this negation list as the single source of truth for "which dist
# outputs are products, not scratch" (see docs/codex/no-magic-values.md).
/dist/*
# The high-fidelity design SOURCE (port_full_design_to_web.py reads it → web/). NOT scratch — it is the
# expensive, hand-authored design work the owner depends on, so it is tracked + durable (2026-06-25).
!/dist/sites/
/dist/sites/*
!/dist/sites/aidoneright-design/
!/dist/agent-skills/
!/dist/aibom/
!/dist/c2pa/
!/dist/croissant/
!/dist/hf/
!/dist/lm-eval-harness/
!/dist/mcp/
!/dist/openlineage/
!/dist/promptfoo/
!/dist/spdx/
!/dist/catalog.sqlite

# Private/internal docs (acquihire material, internal strategy) — NOT part of the open-core publication
docs/internal/

# --- Local platform secrets + runtime state (productionization handoff) ---
# .env carries locally generated dev secrets — never staged (vault flow: production/vault/README.md)
.env
design_handoff_platform_productionization/production/.deploy-state.json
design_handoff_platform_productionization/production/dist/
design_handoff_platform_productionization/production/core/node_modules/

# --- Generated E2E review output (videos/screenshots/html/reports) — regenerable, large ---
/artifacts/

# --- Local transactional-email outbox (rendered dev mail; regenerable) ---
dist/email-outbox/

# --- Retired files/snapshots (retained on disk, not committed) ---
/archive/

# agent runtime state (pid files, loop ledgers, local-service state) — never in git
.agent/

# untracked scratch — dated archive snapshots are not part of the tree
archive/

# descent brain runtime data (accumulating; regenerable)
data/descent-attempts/

# AIDevObserver generated context-foundry candidates may include private local-session digests/summaries.
data/dev-intel/aidevobserver_context_foundry/

# recorded demo videos (large binaries; regenerate via e2e/record_yc_demo.mjs)
artifacts/e2e/videos/

# Open*Hub runtime component store (durable; regenerated by the hub engines)
data/openharnesshub/
generated/

# untracked local generated/scratch dirs (large; regenerated, never committed — kept out of the
# tracked tree AND out of the top-level layout policy, which skips gitignored dirs)
generated_primitive_packs/
manual_source_materials/
scratchpad/

# --- pre-split hygiene (never republish reference material; no vendored deps) ---
node_modules/
_repos/_shared/_reference/
_repos/_shared/repo_reference/

# Kaggle foundry: gitignored raw-notebook cache + resumable cursor + large staged pool (regenerable)
_repos/shared-backend-components/data/dev-intel/kaggle_primitive_foundry/
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/kaggle_primitive_candidates.jsonl

# executable primitive candidates (regenerable from scripts/executable_primitive_library.py --stage)
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/executable_primitive_candidates.jsonl

# flywheel scheduler runtime (state, tick logs, STOP file)
_repos/shared-backend-components/.flywheel/

# large regenerable grid-primitive pool (deterministic via scripts/primitive_grid_remixer.py --mint)
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/grid_primitive_candidates.jsonl

# regenerable persona-primitive pool (deterministic via scripts/persona_primitive_explorer.py --mint)
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/persona_primitive_candidates.jsonl
dist/competitions/autonomous-agent-prediction/submission.zip

# regenerable expanded-primitive pool (LLM expansion loop)
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/expanded_primitive_candidates.jsonl

# regenerable ML-lifecycle primitive pool
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/ml_lifecycle_primitive_candidates.jsonl

# regenerable layered-expansion pool
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/layered_primitive_candidates.jsonl

# the built primitive database (1.6GB+, regenerable via scripts/primitive_database.py --build)
_repos/shared-backend-components/dist/primitives.db
_repos/shared-backend-components/dist/primitives.db-*

# regenerable ML team-role primitive pool
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/ml_team_role_primitive_candidates.jsonl

# regenerable browser-automation primitive pool
_repos/shared-backend-components/data/dev-intel/aidevobserver_edge_foundry/browser_automation_primitive_candidates.jsonl

# semantic index (memmap embeddings, regenerable)
_repos/shared-backend-components/dist/primitive-semantic-index/
.agent/openrouter_keys.txt

# owner-provided secrets (never commit)
.env*

# all local credential pools + the consolidated master key file (never commit)
/_repos/shared-backend-components/catalog/knowledge-packs/data/primitive-domain-partitions/
/_repos/shared-backend-components/catalog/knowledge-packs/data/primitive-search-index-fullcorpus/
/_repos/shared-backend-components/dist/primitive-description-embedding-shards/
/_repos/shared-backend-components/dist/primitive-embedding-shards/
/_repos/shared-backend-components/dist/primitive-facet-embeddings/
/_repos/shared-backend-components/dist/primitive-model-stores/
/_repos/shared-backend-components/dist/primitive-register-embeddings/
/_repos/shared-backend-components/dist/primitive_description_sidecar.db
/_repos/shared-backend-components/dist/primitive_search_federation_overlay.db
# ^ generated stores >50MB, checkpoint 2026-07-11 (rebuildable; P0 cleanup direction: derived data stays out of git)
/_repos/shared-backend-components/catalog/knowledge-packs/data/primitive-search-index/search_docs.jsonl.gz
/_repos/shared-backend-components/catalog/knowledge-packs/data/primitive-search-index/inverted_index.json.gz
