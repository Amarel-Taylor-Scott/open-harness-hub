{
  "pipeline_id": "unstructured_pdf_docling",
  "pipeline_version": "v0",
  "status": "experimental",
  "description": "SEAM ONLY: unstructured PDF -> Docling layout tree -> sentences -> atomic claims -> govern -> package. Docling is not vendored (no-pip env); the parser processor is registered as UNAVAILABLE so this is discoverable but not runnable until a Docling adapter is vendored.",
  "input_schema": "RawDocument.v1",
  "output_schema": "ContextPack.v1",
  "partition_key": "tenant_id",
  "idempotency_key_template": "{tenant_id}:{source_id}:{document_version}:{pipeline_id}:{pipeline_version}",
  "isolation": "shared",
  "steps": [
    {"step_id": "source", "processor": "source.cfpb_fixture@v1", "queue": "pipeline.pdf.source",
     "outputs": ["SourceRecordBatch.v1"]},
    {"step_id": "parse", "processor": "parser.docling@v0", "queue": "pipeline.pdf.parse",
     "inputs": ["SourceRecordBatch.v1"], "outputs": ["DocumentTree.v1"], "depends_on": ["source"]}
  ],
  "gates": ["all_atomic_facts_have_source_handles"]
}
