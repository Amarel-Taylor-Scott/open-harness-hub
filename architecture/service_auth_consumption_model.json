  "source_doc": "docs/architecture/service-auth-and-consumption-model.md",
  "service_registry": "services/registry.yaml",
  "governance_law": {
    "api_keys_internal_forbidden": "API keys are allowed for external SDKs, CLIs, and publisher clients; internal service-to-service calls use service accounts and short-lived tokens.",
    "no_shared_god_token": "Each service has a distinct service account; no credential is shared across all services.",
    "tenant_authorization_required": "Authentication is insufficient; service calls must authorize tenant, object, action, purpose, scope, and data class before data access.",
    "private_bench_server_side_required": "Private-first hub access must be enforced server-side in production; prototype banners are not security controls.",
    "audit_or_receipt_required": "Every privileged cross-service request emits an audit event or receipt with a correlation id."
  },
  "allowed_auth_methods": {
    "user_session": "OIDC/SSO-backed browser session for humans.",
    "external_api_key": "Scoped key for customer SDKs, CLIs, publishers, and webhooks; hash-only at rest.",
    "oauth_client_credentials": "OAuth 2.0 client credentials for confidential clients acting as themselves.",
    "internal_service_token": "Short-lived service token minted for a service account and audience.",
    "mtls_spiffe": "mTLS/SPIFFE or equivalent cloud workload identity for production service-to-service calls.",
    "queue_identity": "Worker identity authorized for specific queues and job kinds.",
    "datastore_workload_identity": "Least-privilege cloud/IAM/workload identity for datastore access.",
    "signed_webhook": "Signed source webhook or connector OAuth grant."
  },
  "token_requirements": {
    "service_tokens_must_include": [
      "iss",
      "sub",
      "aud",
      "exp",
      "tenant_id",
      "scope",
      "purpose",
      "correlation_id"
    ],
    "api_key_records_must_include": [
      "hash",
      "prefix",
      "tenant_id",
      "workspace_id",
      "scopes",
      "created_by",
      "created_at",
      "expires_at",
      "last_used_at",
      "revoked_at"
    ],
    "raw_secret_literals_forbidden": [
      "api_key",
      "client_secret",
      "password",
      "private_key",
      "secret",
      "token"
    ]
  },
