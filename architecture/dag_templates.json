{
  "version": "0.1.0",
  "updated": "2026-06-22",
  "principle": "Canonical DAG templates — typed parameterized SKELETONS with named SLOTS (each slot is a plane to fill with a component). Composition RETRIEVES a matching template and MUTATES its slots (swap the OCR rung, add a validator, drop an unused optional step) rather than synthesizing from scratch. This is the dominant path for the common case: classical component synthesis scales poorly with library size, so templates carry the common case and synthesis is the long-tail fallback. Templates are MINED from winning traces (the library grows itself) and ranked by telemetry success_count. serves_truth=false.",
  "serves_truth": false,
  "templates": [
    {
      "template_id": "document_extraction",
      "capability_family": "document_extraction",
      "keywords": ["extract", "pdf", "document", "invoice", "lease", "fields", "ocr", "schema", "form"],
      "slots": [
        {"step": "parse", "plane": "data_extraction"},
        {"step": "ocr_fallback", "plane": "ocr", "optional": true},
        {"step": "fields", "plane": "field_parsing"},
        {"step": "validate", "plane": "validation"}
      ],
      "edges": [["parse", "fields"], ["ocr_fallback", "fields"], ["fields", "validate"]],
      "success_count": 0,
      "failure_modes": ["handwriting", "rotated_scan", "multi_column"]
    },
