    {"id": "exa", "name": "Exa", "env_vars": ["EXA_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "byo", "platform_limits": null, "unlocks": {"tools": ["exa"], "planes": ["search"]}, "obtain": "exa.ai"},
    {"id": "deepgram", "name": "Deepgram ASR", "env_vars": ["DEEPGRAM_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "byo", "platform_limits": null, "unlocks": {"tools": ["deepgram"], "planes": ["asr"]}, "obtain": "deepgram.com"},
    {"id": "elevenlabs", "name": "ElevenLabs TTS", "env_vars": ["ELEVENLABS_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "byo", "platform_limits": null, "unlocks": {"tools": ["elevenlabs"], "planes": ["tts"]}, "obtain": "elevenlabs.io"},
    {"id": "deepl", "name": "DeepL", "env_vars": ["DEEPL_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "both", "platform_limits": {"free": "500k chars/mo"}, "unlocks": {"tools": ["deepl"], "planes": ["mt"]}, "obtain": "deepl.com/pro-api"},
    {"id": "aws_textract", "name": "AWS Textract", "env_vars": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"], "keyless": false, "free_tier": false, "code_read": false, "key_ownership": "byo", "platform_limits": null, "unlocks": {"planes": ["ocr"]}, "obtain": "console.aws.amazon.com"},
    {"id": "google_cloud_vision", "name": "Google Cloud Vision", "env_vars": ["GOOGLE_APPLICATION_CREDENTIALS"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "byo", "platform_limits": null, "unlocks": {"planes": ["ocr", "vision"]}, "obtain": "console.cloud.google.com"},
    {"id": "azure_di", "name": "Azure Document Intelligence", "env_vars": ["AZURE_DI_KEY", "AZURE_DI_ENDPOINT"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "byo", "platform_limits": null, "unlocks": {"planes": ["ocr"]}, "obtain": "portal.azure.com"}
  ]
