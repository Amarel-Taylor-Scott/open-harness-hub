{
  "version": "0.1.0",
  "updated": "2026-06-22",
  "principle": "The credential PLANE: a single source for every external secret Teleon CONSUMES — the env-var NAME only (never a value), whether the service is keyless / has a free tier, and what plane/tools/sources the key UNLOCKS. This drives the descent's REACHABILITY (the cheapest tool that meets the bar AND is reachable given the present keys) + honest-unavailable (we say 'unavailable: needs OH_LIBRARIESIO_KEY', never fabricate). It complements — does not duplicate — SecretRef.v1 (the runtime pointer that resolves a name to a value) and docs/architecture/service-auth-and-consumption-model.md (the auth model). No-magic-values: the OH_* keys read ad-hoc across the code are catalogued HERE once. serves_truth=false.",
  "serves_truth": false,
  "rule": "env-var NAMES only — never a secret value. A name resolves to a SecretRef.ref at runtime. code_read=true means product code reads it today; false means declared for a tool not yet wired.",
  "services": [
    {"id": "github", "name": "GitHub API", "env_vars": ["OH_GITHUB_TOKEN"], "keyless": true, "free_tier": true, "code_read": true, "unlocks": {"sources": ["github"], "planes": ["search"]}, "obtain": "github.com/settings/tokens"},
    {"id": "libraries_io", "name": "Libraries.io (PyPI/npm/crates keyword search)", "env_vars": ["OH_LIBRARIESIO_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"sources": ["pypi_keyword", "npm", "crates"], "planes": ["search"]}, "obtain": "libraries.io/account"},
    {"id": "llm_gateway", "name": "LLM gateway (Ollama-cloud lane)", "env_vars": ["OH_LLM_API_KEY", "OH_LLM_BASE_URL"], "keyless": false, "free_tier": false, "code_read": true, "unlocks": {"planes": ["llm"]}, "obtain": "provider console"},
    {"id": "llm_hosted", "name": "Hosted LLM lane", "env_vars": ["OH_LLM_HOSTED_API_KEY", "OH_LLM_HOSTED_BASE_URL"], "keyless": false, "free_tier": false, "code_read": true, "unlocks": {"planes": ["llm"]}, "obtain": "provider console"},
    {"id": "embeddings", "name": "Embedding endpoint", "env_vars": ["OH_EMBED_API_KEY", "OH_EMBED_BASE_URL"], "keyless": false, "free_tier": false, "code_read": true, "unlocks": {"planes": ["embedding"]}, "obtain": "provider console"},
    {"id": "cloudflare_ai", "name": "Cloudflare Workers AI", "env_vars": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"], "keyless": false, "free_tier": true, "code_read": true, "unlocks": {"planes": ["llm", "image_gen"]}, "obtain": "dash.cloudflare.com"},
    {"id": "anthropic", "name": "Anthropic", "env_vars": ["ANTHROPIC_API_KEY"], "keyless": false, "free_tier": false, "code_read": false, "unlocks": {"planes": ["llm"]}, "obtain": "console.anthropic.com", "note": "resolved dynamically by inference adapters via secret://provider/anthropic"},
    {"id": "openai", "name": "OpenAI", "env_vars": ["OPENAI_API_KEY"], "keyless": false, "free_tier": false, "code_read": false, "unlocks": {"tools": ["openai_embed", "dalle"], "planes": ["llm", "embedding", "image_gen"]}, "obtain": "platform.openai.com"},
    {"id": "cohere", "name": "Cohere", "env_vars": ["COHERE_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["cohere_rerank"], "planes": ["reranker", "embedding"]}, "obtain": "dashboard.cohere.com"},
    {"id": "tavily", "name": "Tavily search", "env_vars": ["TAVILY_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["tavily"], "planes": ["search"]}, "obtain": "tavily.com"},
    {"id": "brave_search", "name": "Brave Search API", "env_vars": ["BRAVE_SEARCH_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["brave_search"], "planes": ["search"]}, "obtain": "brave.com/search/api"},
    {"id": "serpapi", "name": "SerpAPI", "env_vars": ["SERPAPI_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["serpapi"], "planes": ["search"]}, "obtain": "serpapi.com"},
    {"id": "exa", "name": "Exa", "env_vars": ["EXA_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["exa"], "planes": ["search"]}, "obtain": "exa.ai"},
    {"id": "deepgram", "name": "Deepgram ASR", "env_vars": ["DEEPGRAM_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["deepgram"], "planes": ["asr"]}, "obtain": "deepgram.com"},
    {"id": "elevenlabs", "name": "ElevenLabs TTS", "env_vars": ["ELEVENLABS_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["elevenlabs"], "planes": ["tts"]}, "obtain": "elevenlabs.io"},
    {"id": "deepl", "name": "DeepL", "env_vars": ["DEEPL_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"tools": ["deepl"], "planes": ["mt"]}, "obtain": "deepl.com/pro-api"},
    {"id": "aws_textract", "name": "AWS Textract", "env_vars": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"], "keyless": false, "free_tier": false, "code_read": false, "unlocks": {"planes": ["ocr"]}, "obtain": "console.aws.amazon.com"},
    {"id": "google_cloud_vision", "name": "Google Cloud Vision", "env_vars": ["GOOGLE_APPLICATION_CREDENTIALS"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"planes": ["ocr", "vision"]}, "obtain": "console.cloud.google.com"},
    {"id": "azure_di", "name": "Azure Document Intelligence", "env_vars": ["AZURE_DI_KEY", "AZURE_DI_ENDPOINT"], "keyless": false, "free_tier": true, "code_read": false, "unlocks": {"planes": ["ocr"]}, "obtain": "portal.azure.com"}
  ]
}
