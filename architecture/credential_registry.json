{
  "version": "0.2.0",
  "updated": "2026-06-22",
  "principle": "The credential PLANE: a single source for every external secret Teleon can CONSUME — the env-var NAME only (never a value), whether the service is keyless / has a free tier, what each UNLOCKS (plane/tools/sources), and the KEY-OWNERSHIP model: byo (the tenant pastes their own key -> billed to them, their full plan) | platform (our shared key, used WITHIN platform_limits) | both. This drives the descent's REACHABILITY + honest-unavailable + the add-on flexibility (some tool components are EXTERNAL APIs, e.g. RapidAPI/Apify marketplaces). Mirrors the compute key-ownership model (see byo-compute). Complements SecretRef.v1 (runtime pointer) + the service-auth model. serves_truth=false.",
  "serves_truth": false,
  "rule": "env-var NAMES only — never a secret value. key_ownership in {byo, platform, both}; platform_limits REQUIRED when platform is allowed (the cap on OUR key). A name resolves to a SecretRef.ref at runtime; byo keys are tenant-scoped, never logged.",
  "ownership_legend": {"byo": "tenant pastes their own key -> their account/plan, no platform cap", "platform": "our shared key, usable WITHIN platform_limits", "both": "byo OR platform-within-limits (prefer byo when present)"},
  "services": [
    {"id": "github", "name": "GitHub API", "env_vars": ["OH_GITHUB_TOKEN"], "keyless": true, "free_tier": true, "code_read": true, "key_ownership": "both", "platform_limits": {"keyless": "~10 req/min, 60/hr", "platform_token": "5000/hr"}, "unlocks": {"sources": ["github"], "planes": ["search"]}, "obtain": "github.com/settings/tokens"},
    {"id": "libraries_io", "name": "Libraries.io (PyPI/npm/crates keyword search)", "env_vars": ["OH_LIBRARIESIO_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "both", "platform_limits": {"rate": "60 req/min shared fair-use"}, "unlocks": {"sources": ["pypi_keyword", "npm", "crates"], "planes": ["search"]}, "obtain": "libraries.io/account"},
    {"id": "rapidapi", "name": "RapidAPI marketplace", "env_vars": ["RAPIDAPI_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "both", "platform_limits": {"per_addon": "monthly call cap per add-on; cost-gated", "note": "BYO key = your own RapidAPI plan, no platform cap"}, "unlocks": {"planes": ["search", "data_extraction", "social_scrape", "field_parsing"]}, "obtain": "rapidapi.com"},
    {"id": "apify", "name": "Apify actors marketplace", "env_vars": ["APIFY_TOKEN"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "both", "platform_limits": {"monthly_credits": "platform free-tier credits; BYO token = your plan"}, "unlocks": {"planes": ["browser", "search", "social_scrape", "data_extraction"]}, "obtain": "apify.com"},
    {"id": "llm_gateway", "name": "LLM gateway (Ollama-cloud lane)", "env_vars": ["OH_LLM_API_KEY", "OH_LLM_BASE_URL"], "keyless": false, "free_tier": false, "code_read": true, "key_ownership": "platform", "platform_limits": {"per_tenant": "token budget per tenant"}, "unlocks": {"planes": ["llm"]}, "obtain": "provider console"},
    {"id": "llm_hosted", "name": "Hosted LLM lane", "env_vars": ["OH_LLM_HOSTED_API_KEY", "OH_LLM_HOSTED_BASE_URL"], "keyless": false, "free_tier": false, "code_read": true, "key_ownership": "platform", "platform_limits": {"per_tenant": "token budget per tenant"}, "unlocks": {"planes": ["llm"]}, "obtain": "provider console"},
    {"id": "embeddings", "name": "Embedding endpoint", "env_vars": ["OH_EMBED_API_KEY", "OH_EMBED_BASE_URL"], "keyless": false, "free_tier": false, "code_read": true, "key_ownership": "platform", "platform_limits": {"per_tenant": "token budget per tenant"}, "unlocks": {"planes": ["embedding"]}, "obtain": "provider console"},
    {"id": "cloudflare_ai", "name": "Cloudflare Workers AI", "env_vars": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"], "keyless": false, "free_tier": true, "code_read": true, "key_ownership": "both", "platform_limits": {"neurons": "free-tier daily neurons", "byo": "paste your CF token -> runs on YOUR account"}, "unlocks": {"planes": ["llm", "image_gen"]}, "obtain": "dash.cloudflare.com"},
    {"id": "anthropic", "name": "Anthropic", "env_vars": ["ANTHROPIC_API_KEY"], "keyless": false, "free_tier": false, "code_read": false, "key_ownership": "both", "platform_limits": {"per_tenant": "shared key within a per-tenant token cap"}, "unlocks": {"planes": ["llm"]}, "obtain": "console.anthropic.com", "note": "resolved dynamically by inference adapters via secret://provider/anthropic"},
    {"id": "openai", "name": "OpenAI", "env_vars": ["OPENAI_API_KEY"], "keyless": false, "free_tier": false, "code_read": false, "key_ownership": "both", "platform_limits": {"per_tenant": "shared key within a per-tenant token cap"}, "unlocks": {"tools": ["openai_embed", "dalle"], "planes": ["llm", "embedding", "image_gen"]}, "obtain": "platform.openai.com"},
    {"id": "cohere", "name": "Cohere", "env_vars": ["COHERE_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "both", "platform_limits": {"trial": "rate-limited trial key"}, "unlocks": {"tools": ["cohere_rerank"], "planes": ["reranker", "embedding"]}, "obtain": "dashboard.cohere.com"},
    {"id": "tavily", "name": "Tavily search", "env_vars": ["TAVILY_API_KEY"], "keyless": false, "free_tier": true, "code_read": false, "key_ownership": "both", "platform_limits": {"monthly": "1000 free credits"}, "unlocks": {"tools": ["tavily"], "planes": ["search"]}, "obtain": "tavily.com"},
