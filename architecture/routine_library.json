{
  "version": "1.0",
  "purpose": "The routine library: the canonical inventory of REUSABLE routines (named, repeatable units of work) grouped by the stage they serve. A routine names a single operation, the pattern it instantiates, the template it starts from (if any), its inputs/outputs, the commands that run or prove it, and REAL repo paths where the routine already exists. This is a META index over existing code — it does NOT introduce a new runtime, worker, or framework. Use it to answer: 'what is the named, blessed way to do X, and where is it already done.' Routines whose examples are empty are declared-but-not-yet-implemented and carry a note. The single source of pattern_id values is the canonical 25-pattern list; template_id points into architecture/configuration_standards.json config_types or templates/configs/ where applicable.",
  "pattern_id_source": "the canonical 25-pattern list (also in scripts/check_new_code_uses_standards.py CANONICAL_PATTERN_IDS)",
  "routine_keys": ["routine_id", "pattern_id", "template_id", "inputs", "outputs", "commands", "proofs", "anti_patterns", "examples"],
  "categories": [
    "ingestion_routines",
    "decomposition_routines",
    "durable_worker_routines",
    "reconciliation_routines",
    "optimization_routines",
    "api_ui_routines",
    "docs_proof_routines"
  ],
  "routines": [
