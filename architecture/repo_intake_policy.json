{
  "version": "1.0",
  "note": "Intake governance. A repo NEVER becomes active here. Trend/stars are discovery inputs only; activation requires the proof_to_promote ladder.",
  "default_decision": "watch",
  "quarantine_if": [
    "license_unknown",
    "license_restrictive",
    "archived",
    "no_license"
  ],
  "candidate_requires": {
    "skill": [
      "sandbox",
      "eval"
    ],
    "tool": [
      "visibility_policy",
      "local_emulator",
      "sandbox"
    ],
    "harness": [
      "example_fixture"
    ],
    "template": [
      "local_instantiation_proof"
    ],
    "context": [
      "provenance",
      "visibility_policy"
    ]
  },
  "proof_to_promote_default": [
    "provenance",
    "classification",
    "duplicate_check",
    "risk_license_review",
    "local_eval_or_sandbox",
    "redteam",
    "promotion_decision"
  ],
  "never": [
    "activate_by_trend",
    "activate_by_stars",
    "auto_import",
    "direct_provider_bypass"
  ]
}