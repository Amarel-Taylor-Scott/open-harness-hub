{
  "version": "1.0",
  "updated": "2026-06-09",
  "purpose": "Cloud-Run-like LOCAL service registry for the AI Done Right portfolio (Browser E2E + Local Service Emulation Gate). Every runnable local service/emulator is declared here; the start/stop/health harness and the E2E crawler are driven by this file. Statuses are honest: active_local = verified runnable now; held = exists but blocked (reason given); planned = specified by the gate, not yet built.",
  "law": {
    "no_fake_urls": true,
    "no_production_secrets": true,
    "public_pages_never_write_truth": true,
    "dashboards_are_projection_only": true,
    "raw_keys_never_in_artifacts": true,
    "stop_by_exact_recorded_pid_only": true
  },
  "port_sources": {
    "portfolio_sites": "scripts/portfolio_lib.py PORTS/HUB_PORT (drift-gated by check_local_services_health)",
    "identity": "architecture/identity_realm_registry.json defaults.port (drift-gated)"
  },
  "artifact_outputs": {
    "url_map": "dist/local-service-urls.md",
    "pid_dir": ".agent/local-services",
    "logs_dir": "dist/local-services"
  },
