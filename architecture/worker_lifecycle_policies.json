{
  "version": "2.0",
  "note": "Worker lifecycle policies (C-FLEET-2). Each policy governs a worker's lifetime: ramp-up (min/max), keepalive/cooldown, ramp-down (idle shutdown + idle-burn ceiling), batching (BY REFERENCE into worker_batch_policies.json — no duplicated thresholds), startup cost, allowed priorities/capabilities, the autoscale signal, and the K8s/KEDA mapping. The DB task ledger stays the source of truth; these are capacity-planning inputs to the spawn-decision engine.",
  "priority_enum": ["P0", "P1", "P2", "P3"],
  "autoscale_signal_enum": ["queue_depth", "oldest_age", "schedule", "none"],
  "k8s_mapping_enum": ["Job", "ScaledObject", "ScaledJob", "Deployment+HPA", "CronJob"],
  "policies": [
    {
      "lifecycle_policy_id": "cold_start_each_task",
      "min_workers": 0, "max_workers": 100,
      "batch_policy_id": "on_demand_immediate",
      "keepalive_after_task_seconds": 0,
      "idle_shutdown_seconds": 0,
      "drain_new_work_before_shutdown": false,
      "startup_budget_ms": 8000,
      "max_idle_burn_ms": 0,
      "allowed_priorities": ["P0", "P1", "P2", "P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "Job",
      "use_for": "rare/expensive/risky/isolated tasks (untrusted sandbox, sensitive one-off browser sessions)"
    },
    {
      "lifecycle_policy_id": "burst_keepalive",
      "min_workers": 0, "max_workers": 100,
      "batch_policy_id": "next_available",
      "keepalive_after_task_seconds": 120,
      "idle_shutdown_seconds": 120,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 5000,
      "max_idle_burn_ms": 240000,
      "allowed_priorities": ["P0", "P1", "P2", "P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "ScaledObject",
      "use_for": "bursty work (browser research, source-refresh bursts, document parsing bursts)"
    },
    {
      "lifecycle_policy_id": "warm_pool",
      "min_workers": 1, "max_workers": 25,
      "batch_policy_id": "on_demand_immediate",
      "keepalive_after_task_seconds": 300,
      "idle_shutdown_seconds": 300,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 3000,
      "max_idle_burn_ms": 600000,
      "allowed_priorities": ["P0", "P1", "P2"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "Deployment+HPA",
      "use_for": "low-latency interactive/high-value on-demand work"
    },
    {
      "lifecycle_policy_id": "hot_pool",
      "min_workers": 2, "max_workers": 100,
      "batch_policy_id": "on_demand_immediate",
      "keepalive_after_task_seconds": null,
      "idle_shutdown_seconds": null,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 3000,
      "max_idle_burn_ms": null,
      "allowed_priorities": ["P0", "P1", "P2", "P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "Deployment+HPA",
      "use_for": "constant traffic (steady ingestion/inference, always-on tenant ops)"
    },
    {
      "lifecycle_policy_id": "batch_min_5",
      "min_workers": 0, "max_workers": 50,
      "batch_policy_id": "batch_min_5",
      "keepalive_after_task_seconds": 120,
      "idle_shutdown_seconds": 120,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 5000,
      "max_idle_burn_ms": 180000,
      "allowed_priorities": ["P2", "P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "ScaledJob",
      "use_for": "small throughput batches (PDF parsing, non-urgent verification)"
    },
    {
      "lifecycle_policy_id": "batch_min_25",
      "min_workers": 0, "max_workers": 50,
      "batch_policy_id": "batch_min_25",
      "keepalive_after_task_seconds": 180,
      "idle_shutdown_seconds": 180,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 8000,
      "max_idle_burn_ms": 360000,
      "allowed_priorities": ["P2", "P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "ScaledJob",
      "use_for": "throughput batches (vectorization, embedding, bulk scraping)"
    },
    {
      "lifecycle_policy_id": "batch_min_100",
      "min_workers": 0, "max_workers": 100,
      "batch_policy_id": "batch_min_100",
      "keepalive_after_task_seconds": 300,
      "idle_shutdown_seconds": 300,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 10000,
      "max_idle_burn_ms": 600000,
      "allowed_priorities": ["P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "ScaledJob",
      "use_for": "large throughput batches (reindexing, large refreshes)"
    },
    {
      "lifecycle_policy_id": "scheduled_batch_window",
      "min_workers": 0, "max_workers": 100,
      "batch_policy_id": "batch_min_100",
      "keepalive_after_task_seconds": 300,
      "idle_shutdown_seconds": 300,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 10000,
      "max_idle_burn_ms": 600000,
      "allowed_priorities": ["P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "schedule",
      "k8s_mapping": "CronJob",
      "use_for": "low-priority high-volume scheduled work (nightly backfills, cross-source verification)"
    },
    {
      "lifecycle_policy_id": "high_priority_on_demand",
      "min_workers": 1, "max_workers": 50,
      "batch_policy_id": "on_demand_immediate",
      "keepalive_after_task_seconds": 300,
      "idle_shutdown_seconds": 300,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 3000,
      "max_idle_burn_ms": 600000,
      "allowed_priorities": ["P0", "P1"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "Deployment+HPA",
      "use_for": "urgent customer actions that must never wait for a batch (P0/P1 only)"
    },
    {
      "lifecycle_policy_id": "cooldown_drain",
      "min_workers": 0, "max_workers": 100,
      "batch_policy_id": "next_available",
      "keepalive_after_task_seconds": 90,
      "idle_shutdown_seconds": 90,
      "drain_new_work_before_shutdown": true,
      "startup_budget_ms": 5000,
      "max_idle_burn_ms": 180000,
      "allowed_priorities": ["P0", "P1", "P2", "P3"],
      "allowed_capabilities": ["*"],
      "autoscale_signal": "queue_depth",
      "k8s_mapping": "ScaledObject",
      "use_for": "a worker that paid the cold-start cost should drain any compatible work before exiting"
    }
  ]
}
