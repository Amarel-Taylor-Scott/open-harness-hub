{
  "version": "0.1.0",
  "updated": "2026-06-22",
  "principle": "The frontier shift: from 'AI that answers' to 'AI that completes operational work LOOPS' (perceive→reason→act→verify→iterate). Each loop here is a SEED that runs first in the UNBOUNDED, inefficient mode (every step → a frontier model, re-do work each pass, no caching, max iterations, no early stop) and is then DESCENDED to the BOUNDED, efficient mode (cheapest tool plane per step, deterministic/cached where possible, the LLM reserved for supervision, early-stop when no new progress). Costs are REPRESENTATIVE models declared here (the viz/check compute from them — no magic). Each loop composes capability_taxonomy leaves + tool_planes. serves_truth=false; discovery≠trust.",
  "serves_truth": false,
  "cost_model": "unbounded = steps × unbounded.iterations × unbounded.step_cost ; bounded = steps × bounded.iterations × bounded.step_cost + bounded.supervise",
  "loops": [
    {"id": "research", "name": "Research & intelligence gathering", "examples": ["competitive intel", "VC diligence", "regulatory monitoring"], "maps_to": "knowledge_and_retrieval", "tool_planes": ["search", "vector_store", "reranker", "llm"],
      "loop": ["search", "read", "extract", "compare", "identify gaps", "search again", "summarize"],
      "unbounded": {"per_step": "frontier LLM every step; re-search each pass", "iterations": 10, "step_cost": 0.30, "note": "no caching, no early stop"},
      "bounded": {"per_step": "cheap feed/api retrieval + deterministic dedupe/compare; cheap-LLM synth; frontier only to supervise", "iterations": 3, "step_cost": 0.02, "supervise": 0.03, "early_stop": "no-new-for-2", "note": "cache + dedupe + early stop"}},
    {"id": "extraction", "name": "Information extraction from messy data", "examples": ["contract clauses", "insurance claims", "SEC filings"], "maps_to": "document_and_data", "tool_planes": ["ocr", "llm"],
      "loop": ["ingest", "ocr", "parse", "extract schema", "verify extraction", "repair errors"],
      "unbounded": {"per_step": "whole doc → frontier each field", "iterations": 6, "step_cost": 0.30, "note": "send the whole PDF to the frontier model"},
      "bounded": {"per_step": "OCR + patterns answer before LLM; cheap-LLM on residual; LLM-supervisor audit", "iterations": 2, "step_cost": 0.02, "supervise": 0.02, "early_stop": "all fields filled", "note": "the document cascade"}},
    {"id": "browser_use", "name": "Browser / computer use", "examples": ["fill government forms", "download invoices", "monitor pricing"], "maps_to": "agentic_orchestration", "tool_planes": ["browser", "vision", "llm"],
      "loop": ["observe UI", "decide", "click", "wait", "verify page", "continue"],
      "unbounded": {"per_step": "screenshot → frontier vision every step", "iterations": 12, "step_cost": 0.30, "note": "vision-LLM on every UI state"},
      "bounded": {"per_step": "DOM/accessibility-tree + cheap LLM for the next action; vision only when no DOM; stop at the goal", "iterations": 5, "step_cost": 0.03, "supervise": 0.0, "early_stop": "target field reached", "note": "the LLM-driven browser descent"}},
    {"id": "enterprise_retrieval", "name": "Enterprise knowledge retrieval", "examples": ["search Slack+Jira+Drive", "find a decision", "status report"], "maps_to": "knowledge_and_retrieval", "tool_planes": ["search", "vector_store", "reranker", "llm"],
      "loop": ["query systems", "aggregate context", "rank relevance", "synthesize answer"],
      "unbounded": {"per_step": "dump all results → frontier", "iterations": 6, "step_cost": 0.30, "note": "no rerank, full context to frontier"},
      "bounded": {"per_step": "retrieve + rerank to top-k; cheap-LLM synth; cite sources", "iterations": 2, "step_cost": 0.03, "supervise": 0.0, "early_stop": "answer grounded", "note": "rerank shrinks context"}},
    {"id": "workflow_orchestration", "name": "Workflow orchestration", "examples": ["route tickets", "create CRM records", "onboarding"], "maps_to": "agentic_orchestration", "tool_planes": ["llm"],
      "loop": ["receive trigger", "determine workflow", "execute APIs", "verify", "retry", "complete"],
      "unbounded": {"per_step": "LLM decides every routing + field", "iterations": 6, "step_cost": 0.10, "note": "LLM in every branch"},
      "bounded": {"per_step": "deterministic rules route the known cases; LLM only on the residual; idempotent retries", "iterations": 2, "step_cost": 0.01, "supervise": 0.01, "early_stop": "workflow complete", "note": "rules first"}},
    {"id": "coding", "name": "Coding / software engineering", "examples": ["fix failing CI", "generate tests", "resolve a stack trace"], "maps_to": "software_engineering", "tool_planes": ["static_analysis", "llm"],
      "loop": ["read code", "modify", "run tests", "detect failure", "repair", "repeat"],
      "unbounded": {"per_step": "frontier reads the whole repo each pass", "iterations": 8, "step_cost": 0.40, "note": "whole-repo context every iteration"},
      "bounded": {"per_step": "code-graph + static analysis localize; cheap-LLM patches; tests gate; frontier only when stuck", "iterations": 3, "step_cost": 0.05, "supervise": 0.10, "early_stop": "tests pass", "note": "localize before the LLM"}},
    {"id": "support", "name": "Customer support resolution", "examples": ["password reset", "refund", "cancellation"], "maps_to": "agentic_orchestration", "tool_planes": ["search", "llm"],
      "loop": ["understand problem", "gather account context", "take action", "confirm resolution"],
      "unbounded": {"per_step": "frontier reads everything + decides", "iterations": 5, "step_cost": 0.10, "note": "no intent routing"},
      "bounded": {"per_step": "intent-classify (rules/small model) → known playbook; LLM for novel; escalate on low confidence", "iterations": 2, "step_cost": 0.01, "supervise": 0.01, "early_stop": "resolved or escalated", "note": "intent + playbooks"}},
    {"id": "financial_ops", "name": "Financial operations", "examples": ["invoice reconciliation", "expense audit", "AP automation"], "maps_to": "document_and_data", "tool_planes": ["ocr", "llm"],
      "loop": ["collect docs", "extract fields", "validate", "flag anomalies", "approve"],
      "unbounded": {"per_step": "frontier reads each invoice", "iterations": 6, "step_cost": 0.30, "note": "frontier per document"},
      "bounded": {"per_step": "OCR + deterministic field extract + rule validation; LLM only on flagged anomalies", "iterations": 2, "step_cost": 0.02, "supervise": 0.02, "early_stop": "reconciled", "note": "rules validate, LLM audits"}},
    {"id": "sales_revops", "name": "Sales development / RevOps", "examples": ["lead qualification", "prospect research", "outreach"], "maps_to": "agentic_orchestration", "tool_planes": ["search", "llm"],
      "loop": ["find prospect", "research company", "personalize outreach", "send", "track response"],
      "unbounded": {"per_step": "frontier researches + writes each", "iterations": 6, "step_cost": 0.20, "note": "frontier per prospect"},
      "bounded": {"per_step": "cheap enrich (feed/api) + template + cheap-LLM personalize; frontier only for top accounts", "iterations": 2, "step_cost": 0.02, "supervise": 0.0, "early_stop": "sequence queued", "note": "enrich + template"}},
    {"id": "legal_analysis", "name": "Legal analysis", "examples": ["contract redlining", "compliance review", "diligence"], "maps_to": "governance_and_verification", "tool_planes": ["ocr", "llm"],
      "loop": ["read docs", "extract clauses", "compare precedent", "flag issues"],
      "unbounded": {"per_step": "frontier reads every clause + all precedent", "iterations": 6, "step_cost": 0.40, "note": "frontier over the full corpus"},
      "bounded": {"per_step": "extract clauses (patterns+LLM) → retrieve relevant precedent (rerank) → LLM flags; source-bound", "iterations": 3, "step_cost": 0.05, "supervise": 0.05, "early_stop": "all clauses reviewed", "note": "retrieve, don't reread"}},
    {"id": "cybersecurity_ops", "name": "Cybersecurity operations", "examples": ["malware triage", "SIEM investigation", "incident response"], "maps_to": "governance_and_verification", "tool_planes": ["llm"],
      "loop": ["receive alert", "gather logs", "investigate", "classify", "remediate"],
      "unbounded": {"per_step": "frontier reads all logs each alert", "iterations": 8, "step_cost": 0.30, "note": "frontier over raw logs"},
      "bounded": {"per_step": "rule/heuristic correlation + small classifier triage; LLM only on novel patterns; auto-remediate known", "iterations": 3, "step_cost": 0.03, "supervise": 0.03, "early_stop": "classified", "note": "correlate, then LLM"}},
    {"id": "scientific_discovery", "name": "Scientific / technical discovery", "examples": ["literature review", "hypothesis generation", "experiment planning"], "maps_to": "analytics_and_prediction", "tool_planes": ["search", "llm"],
      "loop": ["generate hypothesis", "simulate", "analyze", "refine hypothesis"],
      "unbounded": {"per_step": "frontier each hypothesis + analysis", "iterations": 10, "step_cost": 0.40, "note": "frontier every loop"},
      "bounded": {"per_step": "deterministic sims + cheap-LLM analysis; frontier to propose/critique; stop on convergence", "iterations": 4, "step_cost": 0.05, "supervise": 0.10, "early_stop": "hypothesis converges", "note": "sim cheap, LLM proposes"}},
    {"id": "procurement_supply_chain", "name": "Procurement & supply chain", "examples": ["vendor sourcing", "risk detection", "PO automation"], "maps_to": "analytics_and_prediction", "tool_planes": ["search", "llm"],
      "loop": ["monitor suppliers", "detect issue", "find alternatives", "execute purchase"],
      "unbounded": {"per_step": "frontier scans every supplier feed", "iterations": 6, "step_cost": 0.20, "note": "frontier over all feeds"},
      "bounded": {"per_step": "feed/api monitors + rule thresholds; LLM only when an issue triggers; deterministic PO", "iterations": 2, "step_cost": 0.02, "supervise": 0.01, "early_stop": "purchase executed", "note": "thresholds trigger the LLM"}},
    {"id": "data_engineering", "name": "Data engineering / ETL", "examples": ["broken-pipeline repair", "schema evolution", "data migration"], "maps_to": "document_and_data", "tool_planes": ["llm"],
      "loop": ["ingest", "detect errors", "repair transformation", "validate output"],
      "unbounded": {"per_step": "frontier rewrites the pipeline each error", "iterations": 6, "step_cost": 0.30, "note": "frontier per error"},
      "bounded": {"per_step": "schema-diff + deterministic repair rules; cheap-LLM for novel mismatches; validate", "iterations": 2, "step_cost": 0.02, "supervise": 0.02, "early_stop": "output validates", "note": "diff + rules"}},
    {"id": "robotics_physical", "name": "Physical world / robotics", "examples": ["warehouse automation", "inspection", "manufacturing"], "maps_to": "media", "tool_planes": ["vision", "llm"],
      "loop": ["observe", "plan", "act", "evaluate", "re-plan"],
      "unbounded": {"per_step": "frontier vision-LLM plans every move", "iterations": 15, "step_cost": 0.30, "note": "frontier in the control loop"},
      "bounded": {"per_step": "local perception + a learned policy for known moves; LLM only for re-planning on failure", "iterations": 6, "step_cost": 0.02, "supervise": 0.05, "early_stop": "task complete", "note": "policy fast-path, LLM on failure"}}
  ],
  "frontiers": [
    {"id": "extraction_infra", "name": "Agentic data-extraction infrastructure (email→attachments→invoices→DB)"},
    {"id": "preprocessing_engines", "name": "Agentic preprocessing engines (raw→chunk→OCR→entities→organize)"},
    {"id": "long_horizon_multiagent", "name": "Long-horizon multi-agent systems (hours/days on a task)"},
    {"id": "agent_memory_infra", "name": "Agent memory infrastructure (persistent state, retrieval planning)"},
    {"id": "verification_agents", "name": "Verification agents (fact-check + cross-validate other agents)"},
    {"id": "autonomous_operators", "name": "Autonomous enterprise operators (AI runs a department)"},
    {"id": "self_healing_infra", "name": "Self-healing infrastructure agents (detect + repair failures)"},
    {"id": "agent_sim_environments", "name": "Agent simulation environments (learn through repeated attempts)"}
  ]
}
