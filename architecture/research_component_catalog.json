    {"id": "llm_driven_browser", "name": "LLM-driven efficient browser (low-cost LLM + Playwright)", "kind": "browse", "tier": "browse", "cost": 5,
      "capabilities": ["list", "links", "text", "structured", "js_render", "deep_detail", "interaction"],
      "needs": ["network", "browser_runtime", "llm"], "guardrail_ref": "browse_strict", "status": "live",
      "feeds_hub": "OpenAgentHub", "serves_truth": false,
      "driver_module": "src/teleon/research/llm_browser.py",
      "driver": {"llm_lane": "low_cost", "engine": "playwright",
        "policy": "minimize steps + tokens: plan the shortest path to the target field, stop as soon as it is found, cap steps + cost",
        "why": "selected by the descent ONLY when an agent runner needs deep_detail / js_render / interaction that cheaper tiers cannot get"}}
  ]
