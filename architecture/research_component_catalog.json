{
  "version": "0.1.0",
  "updated": "2026-06-21",
  "principle": "Research + web-browsing is itself a CATALOG of reusable components, selected by the unbounded->bounded descent. An agent runner enriching an Open*Hub names the DETAIL it needs (a capability) and a budget; the descent picks the CHEAPEST eligible component whose capabilities cover that need and that passes the research guardrails. Cheap structured feeds/APIs first; the expensive LLM-driven browser only when nothing cheaper can get the detail. This catalog is itself Open*Hub content (OpenToolsHub/OpenAgentHub) and is built to grow to hundreds of components.",
  "serves_truth": false,
  "tiers": {"feed": 0, "api": 1, "search": 2, "extract": 3, "render": 4, "browse": 5},
  "capabilities_legend": {
    "list": "enumerate items from a source", "links": "return hyperlinks", "metadata": "structured fields about an item",
    "structured": "machine-structured records (JSON/schema)", "text": "readable body text of a page/doc",
    "js_render": "content that requires JavaScript execution to appear", "deep_detail": "detail reachable only by navigating multiple pages / behind interactions",
    "interaction": "click/scroll/fill to reach content"},
  "components": [
    {"id": "sitemap_feed", "name": "Sitemap / index feed", "kind": "feed", "tier": "feed", "cost": 1,
      "capabilities": ["list", "links"], "needs": ["network"], "guardrail_ref": "default_api", "status": "live",
      "feeds_hub": "OpenToolsHub", "serves_truth": false},
    {"id": "rss_atom_feed", "name": "RSS / Atom feed", "kind": "feed", "tier": "feed", "cost": 1,
      "capabilities": ["list", "links", "text"], "needs": ["network"], "guardrail_ref": "default_api", "status": "live",
      "feeds_hub": "OpenContextHub", "serves_truth": false},
    {"id": "github_releases_api", "name": "GitHub releases/tags API", "kind": "api", "tier": "feed", "cost": 1,
      "capabilities": ["list", "links", "metadata"], "needs": ["network"], "hosts": ["api.github.com"],
      "guardrail_ref": "default_api", "status": "live", "feeds_hub": "OpenToolsHub", "serves_truth": false},
    {"id": "package_registry_api", "name": "Package registry API (pypi/npm/crates)", "kind": "api", "tier": "feed", "cost": 1,
      "capabilities": ["metadata", "structured"], "needs": ["network"], "hosts": ["pypi.org", "registry.npmjs.org", "crates.io"],
      "guardrail_ref": "default_api", "status": "live", "feeds_hub": "OpenToolsHub", "serves_truth": false},
    {"id": "github_api", "name": "GitHub REST/Search API", "kind": "api", "tier": "api", "cost": 2,
      "capabilities": ["list", "links", "metadata", "structured"], "needs": ["network", "api_key_optional"], "hosts": ["api.github.com"],
      "guardrail_ref": "default_api", "status": "live", "feeds_hub": "OpenToolsHub", "serves_truth": false,
      "note": "backs scripts/research_radar.research(q,'github')"},
    {"id": "hn_algolia_api", "name": "HN Algolia search API", "kind": "api", "tier": "api", "cost": 2,
      "capabilities": ["list", "links", "metadata"], "needs": ["network"], "hosts": ["hn.algolia.com"],
      "guardrail_ref": "default_api", "status": "live", "feeds_hub": "OpenHarnessHub", "serves_truth": false},
    {"id": "arxiv_api", "name": "arXiv API", "kind": "api", "tier": "api", "cost": 2,
      "capabilities": ["list", "links", "text", "metadata"], "needs": ["network"], "hosts": ["export.arxiv.org"],
      "guardrail_ref": "default_api", "status": "live", "feeds_hub": "OpenBenchmarkHub", "serves_truth": false},
    {"id": "huggingface_api", "name": "Hugging Face Hub API", "kind": "api", "tier": "api", "cost": 2,
      "capabilities": ["list", "metadata", "structured"], "needs": ["network"], "hosts": ["huggingface.co"],
      "guardrail_ref": "default_api", "status": "live", "feeds_hub": "OpenEndpointHub", "serves_truth": false},
    {"id": "web_search", "name": "Keyed web search", "kind": "search", "tier": "search", "cost": 3,
      "capabilities": ["list", "links"], "needs": ["network", "api_key"], "guardrail_ref": "default_search",
      "status": "candidate", "feeds_hub": "OpenContextHub", "serves_truth": false},
    {"id": "static_fetch_readability", "name": "Static fetch + readability extract", "kind": "extract", "tier": "extract", "cost": 2,
      "capabilities": ["text"], "needs": ["network"], "guardrail_ref": "default_api", "status": "live",
      "feeds_hub": "OpenContextHub", "serves_truth": false},
    {"id": "pdf_extract", "name": "PDF text/structure extract", "kind": "extract", "tier": "extract", "cost": 3,
      "capabilities": ["text", "structured"], "needs": ["network"], "guardrail_ref": "default_api", "status": "live",
      "feeds_hub": "OpenContextHub", "serves_truth": false},
    {"id": "chromium_render", "name": "Headless Chromium render (JS pages)", "kind": "render", "tier": "render", "cost": 4,
      "capabilities": ["text", "links", "js_render"], "needs": ["network", "browser_runtime"], "guardrail_ref": "browse_strict",
