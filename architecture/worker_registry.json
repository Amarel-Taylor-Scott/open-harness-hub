    {
      "worker_id": "verification_gate",
      "bucket_id": "verification_fact_check",
      "module": "scripts/runtime/verification_gate.py",
      "command_types": [],
      "queue": "verify.gate",
      "resource_class": "standard_cpu",
      "determinism": "high",
      "status": "active"
    },
    {
      "worker_id": "reconciliation",
      "bucket_id": "reconciliation_policy",
      "module": "scripts/artifact_graph/reconciliation.py",
      "command_types": [],
      "queue": "reconcile.authority",
      "resource_class": "standard_cpu",
      "determinism": "high",
      "status": "active",
      "note": "deterministic authority"
