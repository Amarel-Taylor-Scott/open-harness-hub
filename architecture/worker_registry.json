    {
      "worker_id": "contextops_research_stub",
      "bucket_id": "open_ended_agent",
      "module": "src/baltor/contextops/research_stub.py",
      "command_types": [
        "agent.research",
        "agent.source_discovery"
      ],
      "queue": "agent.research.open_ended",
      "resource_class": "sandboxed_agent",
      "determinism": "non_deterministic",
      "status": "active",
      "note": "local_stub proposes SourceDiscoveryReport (serves_truth=False)"
    }
