{
  "version": "1.0",
  "note": "Existing Baltor workers classified into buckets. status: active|candidate.",
  "workers": [
    {
      "worker_id": "flywheel_worker",
      "bucket_id": "control_plane",
      "module": "scripts/flywheel_worker.py",
      "command_types": [
        "pipeline.run_step",
        "pipeline.run",
        "pipeline.step"
      ],
      "queue": "flywheel.commands.default",
      "resource_class": "control_plane",
      "determinism": "high",
      "status": "active",
      "note": "durable command dispatcher/runner (control plane); context.consume is owned by consumption_service, tenant.doc by tenant_ingest"
    },
    {
      "worker_id": "durable_store",
      "bucket_id": "control_plane",
      "module": "scripts/durable_store.py",
      "command_types": [],
      "queue": "runtime.commands",
      "resource_class": "control_plane",
      "determinism": "high",
      "status": "active",
      "note": "durable event log + lease queue + retry/DLQ + outbox substrate"
    },
    {
      "worker_id": "tenant_ingest",
      "bucket_id": "ingestion_sync",
      "module": "scripts/ingest/tenant_ingest.py",
      "command_types": [
        "tenant.doc"
      ],
      "queue": "ingest.tenant",
      "resource_class": "io_bound",
      "determinism": "high",
      "status": "active"
    },
    {
      "worker_id": "consumption_service",
      "bucket_id": "native_export",
      "module": "scripts/runtime/consumption.py",
