{
  "version": "1.0",
  "purpose": "The Baltor architecture spine: approved folders + layered import boundaries. Future Baltor code must land in an approved home and obey the dependency direction.",
  "governed_scope": ["src/baltor", "scripts/runtime", "scripts/artifact_graph", "scripts/llm_gateway", "scripts/security", "scripts/pipeline_runtime"],
  "legacy_note": "The broader Open Harness Hub code (catalog/, db/, enrichment/, context_workers/, services/, site/, foundry/, etc.) predates the Baltor spine and is NOT governed by these guardrails; see migration_plan.json.",
  "required_folders": [
    "src/baltor", "src/baltor/contracts", "src/baltor/contracts/envelopes", "src/baltor/contracts/artifacts",
    "src/baltor/contracts/pipeline", "src/baltor/contracts/security", "src/baltor/contracts/llm", "src/baltor/contracts/registry",
    "src/baltor/runtime", "src/baltor/runtime/context", "src/baltor/runtime/harness", "src/baltor/runtime/pipeline",
    "src/baltor/runtime/registry", "src/baltor/runtime/commands", "src/baltor/runtime/events", "src/baltor/runtime/errors", "src/baltor/runtime/clock",
    "src/baltor/ports", "src/baltor/adapters", "src/baltor/adapters/durable_store", "src/baltor/adapters/object_store",
    "src/baltor/adapters/vector_store", "src/baltor/adapters/graph_store", "src/baltor/adapters/event_bus", "src/baltor/adapters/queues", "src/baltor/adapters/http",
    "src/baltor/processors", "src/baltor/processors/source", "src/baltor/processors/parse", "src/baltor/processors/normalize",
    "src/baltor/processors/decompose", "src/baltor/processors/enrich", "src/baltor/processors/vectorize", "src/baltor/processors/graph",
    "src/baltor/processors/conflict", "src/baltor/processors/reconcile", "src/baltor/processors/package", "src/baltor/processors/receipt",
    "src/baltor/artifact_graph", "src/baltor/artifact_graph/ledger", "src/baltor/artifact_graph/source_graph", "src/baltor/artifact_graph/edges",
    "src/baltor/artifact_graph/vectors", "src/baltor/artifact_graph/conflicts", "src/baltor/artifact_graph/reconciliations",
    "src/baltor/llm_gateway", "src/baltor/llm_gateway/core", "src/baltor/llm_gateway/providers", "src/baltor/llm_gateway/validation",
    "src/baltor/llm_gateway/retry", "src/baltor/llm_gateway/cache", "src/baltor/llm_gateway/trace", "src/baltor/llm_gateway/secrets",
    "src/baltor/security", "src/baltor/security/tenants", "src/baltor/security/encryption", "src/baltor/security/privacy", "src/baltor/security/secrets",
    "src/baltor/facts",
    "src/baltor/observability", "src/baltor/observability/logging", "src/baltor/observability/tracing", "src/baltor/observability/metrics", "src/baltor/observability/projections",
    "src/baltor/workers", "src/baltor/api", "src/baltor/api/middleware", "src/baltor/api/routes", "src/baltor/api/projections",
    "src/baltor/demos", "src/baltor/demos/cfpb", "src/baltor/demos/esg", "src/baltor/demos/shared",
    "architecture", "schemas/envelopes", "schemas/artifacts", "schemas/pipeline", "schemas/events", "schemas/api", "schemas/llm", "schemas/security", "schemas/examples", "schemas/consumption",
    "pipelines/active", "pipelines/experimental", "pipelines/deprecated", "pipelines/examples",
    "configs/local", "configs/tenants", "configs/llm_providers", "configs/vector_stores", "configs/object_stores", "configs/observability",
    "docs/adr", "docs/architecture", "docs/contracts", "docs/artifact-graph", "docs/pipelines", "docs/runtime", "docs/llm-gateway", "docs/security", "docs/observability", "docs/operations", "docs/demos",
    "proofs/architecture", "proofs/contracts", "proofs/runtime", "proofs/durable", "proofs/workers", "proofs/ingestion", "proofs/decomposition", "proofs/artifact_graph", "proofs/llm_gateway", "proofs/security", "proofs/observability", "proofs/api", "proofs/demos",
    "web/baltor/pages", "web/baltor/recorders", "tests/unit", "tests/integration", "tests/contract", "tests/regression"
  ],
  "layers": {
    "contracts": {"paths": ["src/baltor/contracts", "schemas"], "purpose": "Versioned payloads/schemas/shared types.", "allowed_project_imports": [], "forbidden_imports": ["src/baltor/processors", "src/baltor/api", "scripts", "web"]},
    "ports": {"paths": ["src/baltor/ports"], "purpose": "Capability interfaces (Protocols).", "allowed_project_imports": ["src/baltor/contracts"], "forbidden_imports": ["src/baltor/adapters", "src/baltor/processors", "scripts", "web"]},
    "adapters": {"paths": ["src/baltor/adapters"], "purpose": "Concrete backends (SQLite/object-store/vector/http).", "allowed_project_imports": ["src/baltor/contracts", "src/baltor/ports"], "forbidden_imports": ["src/baltor/processors", "web"]},
    "runtime": {"paths": ["src/baltor/runtime", "scripts/runtime"], "purpose": "Generic execution/validation/harness/pipeline.", "allowed_project_imports": ["src/baltor/contracts", "src/baltor/ports"], "forbidden_imports": ["src/baltor/processors", "src/baltor/demos", "web", "scripts/baltor_admin_demo_server"]},
    "processors": {"paths": ["src/baltor/processors", "scripts/runtime/builtin_processors.py"], "purpose": "Swappable pipeline steps.", "allowed_project_imports": ["src/baltor/contracts", "src/baltor/ports", "src/baltor/runtime"], "forbidden_imports": ["scripts/baltor_admin_demo_server", "web", "BUS", "DURABLE"]},
    "llm_gateway": {"paths": ["src/baltor/llm_gateway", "scripts/llm_gateway"], "purpose": "The only legal way to call models.", "allowed_project_imports": ["src/baltor/contracts", "src/baltor/ports", "scripts/security"], "forbidden_imports": ["web", "scripts/baltor_admin_demo_server"]},
    "security": {"paths": ["src/baltor/security", "scripts/security"], "purpose": "Tenant isolation, encryption metadata, secret hygiene.", "allowed_project_imports": ["src/baltor/contracts"], "forbidden_imports": ["web"]},
    "workers": {"paths": ["src/baltor/workers", "scripts/flywheel_worker.py"], "purpose": "Claim loops binding queues to the harness.", "allowed_project_imports": ["src/baltor/runtime", "src/baltor/adapters", "src/baltor/processors", "scripts/runtime", "scripts/durable_store"], "forbidden_imports": ["web"]},
    "api": {"paths": ["src/baltor/api", "scripts/baltor_admin_demo_server.py"], "purpose": "HTTP routes + projections.", "allowed_project_imports": ["src/baltor/runtime", "src/baltor/adapters", "src/baltor/processors"], "forbidden_imports": []},
    "web": {"paths": ["web/baltor"], "purpose": "Projection-only UI.", "allowed_project_imports": [], "forbidden_imports": ["durable write"]},
    "scripts": {"paths": ["scripts"], "purpose": "Entrypoints, proof scripts, compatibility wrappers ONLY.", "allowed_project_imports": ["*"], "forbidden_imports": []}
  }
}
