{
  "version": "1.0",
  "purpose": "Shared execution-environment profiles for every abstract Teleon runtime class. Profiles capture pre-autotune defaults, requirements, policy preferences, route preferences, and immutable trust-boundary locks before a concrete cloud/K8s/local backend is selected. WIRING STATUS: these are AUTHORED defaults + guardrails validated by check_teleon_execution_environment_taxonomy; they are NOT yet consumed by the live egress/route selection callers (which pass route_policy_id explicitly to decide_route). Wiring profile.policy_preferences into selection is a tracked follow-up — this file is the authored target, not yet the runtime source.",
  "control_rule": "A worker declares a runtime_class and worker bucket. The profile supplies portable defaults and guardrails; the runtime binding and backend selector may tune only the allowed knobs. Autotuning never changes tenant scope, source authority, secret policy, egress restrictions, or truth authority.",
  "surface_family_enum": [
    "function",
    "serverless_container",
    "kubernetes",
    "durable_workflow",
    "browser_pool",
    "gpu_pool",
    "stream",
    "local"
  ],
  "state_model_enum": [
    "stateless",
    "ephemeral",
    "warm_pool",
    "durable",
    "stateful_singleton"
  ],
  "trigger_model_enum": [
    "http",
    "event",
    "queue",
    "schedule",
    "manual",
    "stream",
    "workflow"
  ],
  "autotuning_policy_templates": {
    "default_safe_autotune": {
      "allowed_knobs": [
        "backend_order_within_eligible_set",
        "concurrency",
        "timeout_within_sla",
        "max_replicas",
        "keepalive_seconds",
        "batch_policy_id",
        "resource_class_upward_only"
      ],
      "forbidden_knobs": [
        "trust_boundary",
        "tenant_scope",
        "secret_policy",
        "source_authority",
        "egress_blocklist",
        "serves_truth"
      ],
      "promotion_gate": "parallel_path_evidence_required",
      "requires_baseline_rollback": true
    },
    "pool_safe_autotune": {
      "allowed_knobs": [
        "backend_order_within_eligible_set",
        "concurrency",
        "timeout_within_sla",
        "min_replicas_within_policy",
