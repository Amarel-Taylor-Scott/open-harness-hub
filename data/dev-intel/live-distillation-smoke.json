{
  "seam": "real distillation (LLM -> deterministic rule generation)",
  "accepted": true,
  "holdout_accuracy": 1.0,
  "rule": {
    "rules": [
      {
        "if": [
          {
            "field": "amount",
            "op": "<=",
            "value": 30
          },
          {
            "field": "days",
            "op": "<=",
            "value": 30
          }
        ],
        "then": "approve"
      }
    ],
    "default": "deny"
  },
  "n_train": 8,
  "n_holdout": 4,
  "verified": true,
  "serves_truth": false,
  "note": "a LIVE model GENERATED the deterministic rule; lossless-validated on held-out before replacing the LLM"
}
