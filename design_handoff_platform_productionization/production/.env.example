# Copy to .env and fill in. NOTHING here has a working default on purpose —
# the platform refuses to fake providers or secrets (goal rule: no bypasses).

# Path to your local checkout: the folder that CONTAINS openharness/
SITE_ROOT=../uploads/Designs

# Core signing/auth secrets — generate with: openssl rand -hex 32
CORE_JWT_SECRET=
CORE_SIGNING_SECRET=

# Service accounts (standardized: SERVICE_<ID>_SECRET) — generate per service
SERVICE_PARENT_SECRET=
SERVICE_BALTOR_SECRET=
SERVICE_TELEON_SECRET=

# Shared LLM Plane providers — set at least one to enable /llm/v1/chat/completions.
# If unset, the plane returns 501 with instructions (never a fake completion).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Shared LLM plane — extra providers (OpenAI-compatible). Set ONE to enable real completions.
# OpenRouter: one key, hundreds of models. Use model ids like openrouter/anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=
# Ollama Cloud (set the key) or local Ollama (leave key empty, runs at OLLAMA_HOST). Models: ollama/llama3.3 etc.
OLLAMA_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
