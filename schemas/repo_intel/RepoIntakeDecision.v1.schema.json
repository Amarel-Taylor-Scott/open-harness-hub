{
  "$id": "repo_intel/RepoIntakeDecision.v1",
  "title": "RepoIntakeDecision.v1",
  "type": "object",
  "additionalProperties": true,
  "description": "The governed intake decision for a repo. A repo can NEVER be 'active' here \u2014 the strongest outcome is a *candidate* with proof_to_promote (sandbox/eval/redteam/contract/local-equivalent). Discovery is not trust; trend is not fit; fit is not activation.",
  "required": [
    "repo_id",
    "decision",
    "reasons",
    "hub_mappings",
    "proof_to_promote",
    "owner",
    "next_review_at"
  ],
  "properties": {
    "repo_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ignore",
        "watch",
        "classify_only",
        "intake_as_skill_candidate",
        "intake_as_tool_candidate",
        "intake_as_harness_candidate",
        "intake_as_template_candidate",
        "intake_as_context_candidate",
        "propose_teleon_integration",
        "propose_baltor_integration",
        "quarantine"
      ]
    },
    "reasons": {
      "type": "array"
    },
    "hub_mappings": {
      "type": "array"
    },
    "proof_to_promote": {
      "type": "array"
    },
    "local_eval_required": {
      "type": "boolean"
    },
    "sandbox_required": {
      "type": "boolean"
    },
    "owner": {
      "type": "string"
    },
    "next_review_at": {
      "type": "string"
    }
  }
}