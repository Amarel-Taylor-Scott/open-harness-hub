{
  "$id": "inference/ModelInvocationReceipt.v1",
  "title": "ModelInvocationReceipt.v1",
  "type": "object",
  "additionalProperties": true,
  "description": "Mandatory PROVENANCE of one model call: which model class was requested, which provider NODE/model was ACTUALLY used, the fallback trail + rejected candidates, input/output hashes, policy checks, cost/latency/tokens, and the ALLOWED USE the result qualifies for (a lower-tier fallback may yield a draft/candidate but not a promotable/served output). No LLM output is accepted without one.",
  "required": [
    "receipt_id",
    "request_id",
    "object_id",
    "preference_id",
    "requested_model_class",
    "selected_provider_node_id",
    "selected_model",
    "fallback_used",
    "fallback_reason_codes",
    "rejected_candidates",
    "input_hash",
    "output_hash",
    "policy_checks",
    "allowed_use",
    "created_at"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "preference_id": {
      "type": "string"
    },
    "requested_model_class": {
      "type": "string"
    },
    "selected_provider_node_id": {
      "type": "string"
    },
    "selected_model": {
      "type": "string"
    },
    "selected_region": {
      "type": "string"
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "input_hash": {
      "type": "string"
    },
    "output_hash": {
      "type": "string"
    },
    "prompt_template_hash": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "tokens": {
      "type": "object"
    },
    "cost_estimate_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "number",
        "null"
      ]
    },
    "policy_checks": {
      "type": "object"
    },
    "allowed_use": {
      "type": "string",
      "description": "draft | candidate | non_serving_explanation | promotable | served \u2014 the strongest downstream use this output qualifies for given tier/fallback/policy"
    },
    "created_at": {
      "type": "string"
    }
  }
}