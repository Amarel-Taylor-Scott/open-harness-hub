      "type": "string"
    },
    "effective": {
      "type": "object"
    },
    "resolved_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_policy_hash": {
      "type": "string"
    },
    "conflict_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}