{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/flywheel/decision-receipt.schema.json",
  "title": "Decision receipt",
  "description": "The auditable record an AI-agent (L5) flywheel emits after deciding within a decision-context: what it decided, why, the evidence used, and the actions proposed/taken/blocked under policy.",
  "type": "object",
  "required": ["kind", "id", "decision_context_id", "decision", "reason", "actions_proposed", "actions_taken", "policy_decision", "created_at"],
  "properties": {
    "kind": { "type": "string", "const": "baltor.decision-receipt.v1" },
    "id": { "type": "string" },
    "decision_context_id": { "type": "string" },
    "decision": { "type": "string" },
    "reason": { "type": "string" },
    "evidence_used": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ctx://" }
    },
    "actions_proposed": { "type": "array", "items": { "type": "string" } },
    "actions_taken": { "type": "array", "items": { "type": "string" } },
    "actions_blocked": { "type": "array", "items": { "type": "string" } },
    "policy_decision": { "type": "string", "enum": ["allow", "allow_with_conditions", "block", "human_review"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_review": { "type": "boolean" },
    "next_trigger": { "type": "string" },
    "lineage": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
