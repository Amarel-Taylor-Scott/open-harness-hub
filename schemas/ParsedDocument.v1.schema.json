{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ParsedDocument.v1.schema.json",
  "title": "ParsedDocument.v1",
  "description": "The canonical, ENGINE-NEUTRAL parsed-document artifact. Every parser adapter (Docling/MinerU/Tika/MarkItDown/GROBID/OmniParse/cloud-DocAI) maps its native output into THIS shape, so the platform owns the schema and engines are swappable. It carries the page/block tree, a deterministic quality block (scored by scripts/ingest/parse_quality.py), and engine_runs provenance — the parse-adjudicator keeps EVERY engine's output as evidence (lossless), marking which was selected. serves_truth is pinned false: a parse is evidence/candidate, NEVER a served fact.",
  "type": "object",
  "required": ["schema_version", "pages", "serves_truth"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "ParsedDocument.v1"},
    "document": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mime_type": {"type": "string"},
        "title": {"type": "string"},
        "page_count": {"type": "integer", "minimum": 0},
        "language": {"type": "string"},
        "is_scanned": {"type": "boolean"}
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_no", "blocks"],
        "additionalProperties": true,
        "properties": {
          "page_no": {"type": "integer", "minimum": 1},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "ordinal", "confidence"],
              "additionalProperties": true,
              "properties": {
                "kind": {"type": "string"},
                "ordinal": {"type": "integer", "minimum": 0},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "text": {"type": "string"},
                "artifact_uri": {"type": "string"},
                "bbox": {"type": ["object", "null"]}
              }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "description": "Deterministic parse-quality assessment (scripts/ingest/parse_quality.py). RANKS a parse; never a served fact.",
      "additionalProperties": true,
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "text_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "page_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "reading_order_score": {"type": "number", "minimum": 0, "maximum": 1},
        "table_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "avg_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "block_count": {"type": "integer", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "engine_runs": {
      "type": "array",
      "description": "Every parser engine the adjudicator ran on this document — LOSSLESS: the losers are preserved as evidence, not discarded. Exactly one has selected=true.",
      "items": {
        "type": "object",
        "required": ["engine", "selected"],
        "additionalProperties": true,
        "properties": {
          "engine": {"type": "string"},
          "engine_version": {"type": "string"},
          "selected": {"type": "boolean"},
          "overall_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "reason": {"type": "string"}
        }
      }
    },
    "serves_truth": {"const": false}
  }
}
