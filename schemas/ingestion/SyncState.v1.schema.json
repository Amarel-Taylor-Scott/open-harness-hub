{
  "$id": "ingestion/SyncState.v1", "title": "SyncState.v1", "type": "object", "additionalProperties": false,
  "description": "The durable per-(tenant,source) sync state a connector reads/writes so the next sync is incremental and resumable. Holds the active cursor, the last successful run, and the current mode. Tenant-scoped: a tenant_private source's SyncState NEVER updates a global_public source's state.",
  "required": ["schema_version", "tenant_id", "source_id", "scope", "sync_mode", "status", "updated_at"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["SyncState.v1"]},
    "tenant_id": {"type": "string"},
    "source_id": {"type": "string"},
    "source_version": {"type": "string"},
    "scope": {"type": "string", "enum": ["global_public", "tenant_private", "tenant_shared"]},
    "sync_mode": {"type": "string", "enum": ["full_sync", "incremental_sync", "backfill", "webhook_push", "paused"]},
    "status": {"type": "string", "enum": ["never_synced", "in_progress", "succeeded", "failed", "paused"]},
    "cursor": {"type": "object", "additionalProperties": false,
      "required": ["cursor_strategy", "cursor_value"],
      "properties": {
        "cursor_strategy": {"type": "string", "enum": ["timestamp", "monotonic_id", "etag", "page_token", "content_hash_set", "none"]},
        "cursor_value": {"type": "string"},
        "high_water_mark": {"type": "string"}
      }},
    "last_run_id": {"type": "string"},
    "last_success_at": {"type": "string"},
    "last_artifact_count": {"type": "integer"},
    "consecutive_failures": {"type": "integer"},
    "updated_at": {"type": "string"}
  }
}
