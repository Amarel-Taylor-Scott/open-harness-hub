{
  "$id": "teleon/lift/ImportedWorkload.v1", "title": "ImportedWorkload.v1", "type": "object", "additionalProperties": false,
  "description": "A provider-native workload (AWS Lambda / GCP/Azure function / Kubernetes object) normalized by Teleon Lift into a canonical, vendor-neutral record. SAFETY: env-var VALUES are never carried — env_redacted_keys holds key NAMES only. runtime_class_guess is drawn from architecture/capability_runtime_classes.json so the workload is already CTS-1-bindable. Produced read-only (discovery does not change production).",
  "required": ["schema_version", "id", "source", "native_kind", "native_name", "runtime_class_guess", "interpretation", "owner_hints", "runtime", "triggers", "permissions", "env_redacted_keys", "connected_systems", "telemetry_refs", "imported_at"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["ImportedWorkload.v1"]},
    "id": {"type": "string"},
    "source": {"type": "string", "description": "aws | gcp | azure | k8s"},
    "native_kind": {"type": "string", "description": "function | Job | CronJob | Deployment | ..."},
    "native_name": {"type": "string"},
    "account": {"type": "string"},
    "region": {"type": "string"},
    "namespace": {"type": "string"},
    "runtime_class_guess": {"type": ["string", "null"], "description": "a class from capability_runtime_classes.json (null for pure interface hints)"},
    "interpretation": {"type": "string", "description": "capability_task_implementation | scheduled_trigger | long_running_worker_or_service | ..."},
    "interpretation_note": {"type": "string"},
    "owner_hints": {"type": "object", "description": "{tags:{}, repo:str} — non-authoritative ownership/purpose hints"},
    "runtime": {"type": "object", "description": "normalized runtime config (no secret values)"},
    "triggers": {"type": "array", "items": {"type": "object"}, "description": "[{type, ref}] schedule/http/queue/event"},
    "permissions": {"type": "object", "description": "{identity} — execution role / service account (summary only)"},
    "env_redacted_keys": {"type": "array", "items": {"type": "string"}, "description": "env-var KEY NAMES only (values never imported)"},
    "connected_systems": {"type": "array", "items": {"type": "string"}},
    "telemetry_refs": {"type": "object", "description": "{logs_ref?, metrics_ref?} — references, not contents"},
    "imported_at": {"type": "string", "description": "injected timestamp (deterministic, no wall-clock)"}
  }
}
