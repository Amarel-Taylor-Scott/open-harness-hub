{
  "$id": "workers/SupervisorScaling.v1",
  "title": "SupervisorScaling",
  "description": "The five control-plane coordination records (C-FLEET-3) that let multiple lightweight flywheel supervisors run safely: instances, leader leases, shards, ticks, and idempotent decisions. The DB task ledger remains the source of truth; these coordinate WHO scans/schedules what, never WHAT a worker executes.",
  "type": "object",
  "definitions": {
    "SupervisorInstance": {
      "type": "object",
      "properties": {
        "supervisor_id": {"type": "string"}, "hostname": {"type": "string"}, "pid": {"type": "integer"},
        "version": {"type": "string"}, "status": {"type": "string"}, "started_at": {"type": "string"},
        "heartbeat_at": {"type": "string"}, "last_tick_at": {"type": "string"}
      },
      "required": ["supervisor_id", "status", "started_at", "heartbeat_at"]
    },
    "SupervisorLease": {
      "type": "object",
      "properties": {
        "lease_name": {"type": "string"}, "owner_id": {"type": "string"},
        "lease_until": {"type": "string"}, "heartbeat_at": {"type": "string"}
      },
      "required": ["lease_name", "owner_id", "lease_until"]
    },
    "SupervisorShard": {
      "type": "object",
      "properties": {
        "shard_id": {"type": "string"}, "shard_type": {"type": "string"}, "shard_key": {"type": "string"},
        "owner_id": {"type": "string"}, "lease_until": {"type": "string"}, "heartbeat_at": {"type": "string"},
        "status": {"type": "string", "enum": ["unclaimed", "owned"]}
      },
      "required": ["shard_id", "shard_type", "shard_key", "status"]
    },
    "SupervisorTick": {
      "type": "object",
      "properties": {
        "supervisor_id": {"type": "string"}, "shard_id": {"type": "string"}, "started_at": {"type": "string"},
        "duration_ms": {"type": "integer"}, "due_task_count": {"type": "integer"},
        "scheduled_count": {"type": "integer"}, "interval_ms": {"type": "integer"}
      },
      "required": ["supervisor_id", "started_at", "duration_ms"]
    },
    "SupervisorDecision": {
      "type": "object",
      "properties": {
        "decision_id": {"type": "string"}, "supervisor_id": {"type": "string"}, "shard_id": {"type": "string"},
        "decision_type": {"type": "string"}, "reason": {"type": "string"}, "idempotency_key": {"type": "string"},
        "output_command_ids": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string"}
      },
      "required": ["decision_id", "supervisor_id", "decision_type", "idempotency_key", "created_at"]
    }
  },
  "properties": {
    "instances": {"type": "array", "items": {"$ref": "#/definitions/SupervisorInstance"}},
    "leases": {"type": "array", "items": {"$ref": "#/definitions/SupervisorLease"}},
    "shards": {"type": "array", "items": {"$ref": "#/definitions/SupervisorShard"}},
    "ticks": {"type": "array", "items": {"$ref": "#/definitions/SupervisorTick"}},
    "decisions": {"type": "array", "items": {"$ref": "#/definitions/SupervisorDecision"}}
  }
}
