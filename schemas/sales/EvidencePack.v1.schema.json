{
  "$id": "sales/EvidencePack.v1",
  "title": "EvidencePack.v1",
  "type": "object",
  "additionalProperties": true,
  "description": "A proof artifact for a lead: what was observed, under what authorization, with what risk hypothesis, and whether it is safe to state publicly. Defaults: public_claim_safe=false. A pack about a NAMED real company cannot be public unless review_status=approved. Diagnostics describe observed answer patterns; never a legal conclusion. Private-first.",
  "required": ["evidence_pack_id", "company_id", "target_product", "pain_hypothesis", "observed_artifacts",
               "risk_categories", "confidence", "public_claim_safe", "requires_legal_review", "review_status",
               "claim_language_class", "created_at"],
  "properties": {
    "evidence_pack_id": {"type": "string"},
    "company_id": {"type": "string"},
    "company_is_synthetic": {"type": "boolean", "description": "true for example/exemplar packs (no real company named)"},
    "target_product": {"type": "string", "enum": ["Teleon", "Baltor", "OpenContextHub", "OpenSkillsHub", "OpenToolsHub", "OpenHarnessHub"]},
    "pain_hypothesis": {"type": "string"},
    "authorization_basis": {"type": "string", "enum": ["own_system", "customer_provided", "written_authorization", "public_static_metadata"]},
    "diagnostic_run_ids": {"type": "array", "items": {"type": "string"}},
    "observed_artifacts": {"type": "array", "description": "each: {kind, summary, source_url|source_ref, timestamp}"},
    "source_urls": {"type": "array", "items": {"type": "string"}},
    "risk_categories": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "public_claim_safe": {"type": "boolean"},
    "requires_legal_review": {"type": "boolean"},
    "review_status": {"type": "string", "enum": ["not_required", "pending", "approved", "rejected"]},
    "claim_language_class": {"type": "string", "enum": ["safe", "accusatory", "legal_conclusion"]},
    "recommended_outreach_ref": {"type": ["string", "null"]},
    "demo_url": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
