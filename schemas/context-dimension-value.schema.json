{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/context-dimension-value.schema.json",
  "title": "Context dimension value",
  "description": "Versioned assessment of a dimension for a context object, artifact, relationship, assertion, or pack. Scores are assessments, not source facts.",
  "type": "object",
  "required": ["kind", "dimension_value_id", "dimension_id", "subject_id", "value", "assessed_at"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "baltor.context-dimension-value.v1"
    },
    "dimension_value_id": {
      "type": "string"
    },
    "dimension_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_kind": {
      "type": "string",
      "enum": ["context_object", "context_version", "context_artifact", "context_relationship", "context_assertion", "context_pack", "source_handle", "custom"]
    },
    "value": {},
    "normalized_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "label": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
