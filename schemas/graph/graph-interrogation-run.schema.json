{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/graph/graph-interrogation-run.schema.json",
  "title": "Graph interrogation run",
  "description": "The record of one 'interrogate the graph' query: the deterministic, source-cited answer derived by traversing context objects + relationships + assertions, the authority chosen among any contradictions, the explainability paths, and whether a context-object swarm is recommended. Facts come from the graph; an optional model only phrases the prose (model_used=true).",
  "type": "object",
  "required": ["kind", "interrogation_run_id", "question", "created_at"],
  "properties": {
    "kind": { "type": "string", "const": "baltor.graph-interrogation-run" },
    "interrogation_run_id": { "type": "string" },
    "question": { "type": "string" },
    "answer": { "type": "string" },
    "answer_value": {},
    "authority": {
      "type": ["object", "null"],
      "properties": {
        "subject_id": { "type": "string" },
        "value": {},
        "confidence": { "type": ["number", "null"] },
        "staleness": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "source_handles": { "type": "array", "items": { "type": "string", "pattern": "^ctx://" } },
    "contradictions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "objects_consulted": { "type": "array", "items": { "type": "string" } },
    "paths_used": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "uncertainty": { "type": "string", "enum": ["low", "medium", "high"] },
    "suggested_next_query": { "type": ["string", "null"] },
    "swarm_recommended": { "type": "boolean" },
    "swarm_reason": { "type": ["string", "null"] },
    "deterministic": { "type": "boolean" },
    "model_used": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
