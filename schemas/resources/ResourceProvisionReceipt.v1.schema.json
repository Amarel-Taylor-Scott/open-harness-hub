{
  "$id": "resources/ResourceProvisionReceipt.v1",
  "title": "ResourceProvisionReceipt.v1",
  "type": "object",
  "additionalProperties": false,
  "description": "Proof that a resource was provisioned (or that provisioning was refused). Records the spec, the resulting binding, ownership/TTL, and the local-equivalent fallback used when a cloud provider was unavailable. No raw secrets — secret_ref/key_ref only.",
  "required": ["receipt_id", "spec_id", "resource_ref", "outcome", "provider", "created_at"],
  "properties": {
    "receipt_id": {"type": "string"},
    "spec_id": {"type": "string"},
    "resource_ref": {"type": "string"},
    "binding_id": {"type": ["string", "null"]},
    "outcome": {"type": "string", "enum": ["provisioned", "reused_existing", "refused_policy", "provider_unavailable_local_fallback"]},
    "provider": {"type": "string"},
    "ownership_code": {"type": "integer"},
    "ttl_seconds": {"type": ["integer", "null"]},
    "cleanup_required": {"type": "boolean"},
    "local_fallback_used": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  }
}
