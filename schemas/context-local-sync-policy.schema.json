{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness-hub.dev/schemas/context-local-sync-policy.schema.json",
  "title": "Context local sync policy",
  "description": "Policy for hybrid local encrypted memory, encrypted cloud sync, offline context cache, and company-readable context gateway access.",
  "type": "object",
  "required": ["kind", "local_sync_policy_id", "offline_policy", "sync_modes", "created_at"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "baltor.context-local-sync-policy.v1"
    },
    "local_sync_policy_id": {
      "type": "string"
    },
    "sync_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["local_only", "encrypted_event_log", "encrypted_blob_relay", "git_encrypted", "company_context_cache", "custom"]
      }
    },
    "offline_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "cloud_visibility": {
      "type": "object",
      "additionalProperties": true
    },
    "tool_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
