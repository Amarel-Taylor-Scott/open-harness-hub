digraph baltor {
graph [rankdir=TB, splines=polyline, bgcolor="#0a1524", fontname="DejaVu Sans", labelloc=t, label="BALTOR SHOT COMPOSER  /  FRAME + AUDIO DAG", fontcolor="#e4f0f7", fontsize=24, nodesep=.28, ranksep=.55];
node [shape=box, style="rounded,filled", color="#4b9ba5", fillcolor="#143047", fontcolor="#f3f7f6", fontname="DejaVu Sans", fontsize=11, penwidth=1.2, margin="0.12,0.08"];
edge [color="#77bec4", arrowsize=.6, penwidth=1.2];
"timeline" [label="timeline\ntimeline.resolve", fillcolor="#23465a"];
"camera" [label="camera\ncamera.solve", fillcolor="#23465a"];
"sky" [label="sky\nimage.plate", fillcolor="#23465a"];
"parallax" [label="parallax\nimage.parallax", fillcolor="#23465a"];
"landmarks" [label="landmarks\nscene.landmarks", fillcolor="#23465a"];
"rig" [label="rig\nactor.pose", fillcolor="#23465a"];
"foreground" [label="foreground\nscene.occlude", fillcolor="#23465a"];
"atmosphere" [label="atmosphere\nfx.weather", fillcolor="#23465a"];
"grade" [label="grade\nfx.grade", fillcolor="#23465a"];
"framing" [label="framing\nshot.framing", fillcolor="#23465a"];
"split_panel" [label="split_panel\nshot.split_panel", fillcolor="#365070"];
"picture_in_picture" [label="picture_in_picture\nshot.pip", fillcolor="#365070"];
"transition" [label="transition\ntransition.cut_mask", fillcolor="#23465a"];
"caption" [label="caption\ntext.motion", fillcolor="#23465a"];
"border" [label="border\nfx.border", fillcolor="#23465a"];
"encode" [label="encode\nvideo.encode", fillcolor="#23465a"];
"audio" [label="audio\naudio.events", fillcolor="#23465a"];
"mux" [label="mux\nvideo.mux", fillcolor="#365070"];
"qa" [label="qa\nmedia.quality_check", fillcolor="#365070"];
"timeline" -> "camera";
"camera" -> "sky";
"sky" -> "parallax";
"camera" -> "parallax";
"parallax" -> "landmarks";
"camera" -> "landmarks";
"timeline" -> "rig";
"camera" -> "rig";
"landmarks" -> "rig";
"rig" -> "foreground";
"camera" -> "foreground";
"foreground" -> "atmosphere";
"timeline" -> "atmosphere";
"atmosphere" -> "grade";
"grade" -> "framing";
"timeline" -> "framing";
"framing" -> "split_panel";
"timeline" -> "split_panel";
"split_panel" -> "picture_in_picture";
"timeline" -> "picture_in_picture";
"picture_in_picture" -> "transition";
"timeline" -> "transition";
"transition" -> "caption";
"timeline" -> "caption";
"caption" -> "border";
"timeline" -> "border";
"border" -> "encode";
"timeline" -> "audio";
"encode" -> "mux";
"audio" -> "mux";
"mux" -> "qa";
"ref_files" [label="Authorized reference MP4\n(NOT accessible yet)", color="#e4a969", fillcolor="#543723",style="rounded,dashed,filled"];
"flow" [label="Per-frame CV / scene cuts\n(local-video analyzer)",color="#e4a969",fillcolor="#543723",style="rounded,dashed,filled"];
"human" [label="Human shot verification\nNo source frames reused",color="#e4a969",fillcolor="#543723",style="rounded,dashed,filled"];
"ref_files" -> "flow" [style=dashed,color="#ca956e"];
"flow" -> "human" [style=dashed,color="#ca956e"];
"human" -> "timeline" [style=dashed,color="#ca956e"];
}