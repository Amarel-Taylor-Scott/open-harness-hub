digraph BaltorSpatial {
  graph [bgcolor="#0B1420",rankdir=LR,splines=ortho,pad=0.2,ranksep=.57,nodesep=.20];
  node [shape=box,style="rounded,filled",fillcolor="#172638",color="#4C6776",fontcolor="#EDF3F5",fontname="DejaVu Sans",fontsize=10,margin=".10,.07"];
  edge [color="#647785",penwidth=1.0,arrowsize=.5];
  "timeline" [label="timeline.resolve\ntimeline",color="#8BE0D1"];
  "source_rights" [label="rights.check\nsource_rights",color="#8BE0D1"];
  "canvas" [label="spatial.canvas\ncanvas",color="#8BE0D1"];
  "safe_zone" [label="spatial.safe\nsafe_zone",color="#8BE0D1"];
  "scene_assets" [label="scene.plates\nscene_assets",color="#8BE0D1"];
  "camera" [label="camera.solve\ncamera",color="#8BE0D1"];
  "background" [label="scene.parallax\nbackground",color="#8BE0D1"];
  "props" [label="scene.landmarks\nprops",color="#8BE0D1"];
  "character" [label="rig.pose\ncharacter",color="#8BE0D1"];
  "foreground" [label="scene.occlude\nforeground",color="#8BE0D1"];
  "atmosphere" [label="fx.weather\natmosphere",color="#8BE0D1"];
  "color_grade" [label="fx.grade\ncolor_grade",color="#8BE0D1"];
  "frame_crop" [label="camera.final_crop\nframe_crop",color="#8BE0D1"];
  "shot_style" [label="layout.preset\nshot_style",color="#8BE0D1"];
  "safe_candidate" [label="layout.activity_advisor\nsafe_candidate",color="#FFD88C"];
  "anchor_solver" [label="layout.anchors\nanchor_solver",color="#8BE0D1"];
  "padding" [label="layout.padding\npadding",color="#8BE0D1"];
  "text_fit" [label="text.wrap_fit\ntext_fit",color="#8BE0D1"];
  "timing" [label="element.visibility\ntiming",color="#8BE0D1"];
  "shape_layers" [label="shape.raster\nshape_layers",color="#8BE0D1"];
  "text_layers" [label="text.raster\ntext_layers",color="#8BE0D1"];
  "image_layers" [label="image.crop_fit\nimage_layers",color="#8BE0D1"];
  "layer_sort" [label="layers.z_sort\nlayer_sort",color="#8BE0D1"];
  "layer_blend" [label="layers.alpha_blend\nlayer_blend",color="#8BE0D1"];
  "layout_qa" [label="qa.spatial\nlayout_qa",color="#8BE0D1"];
  "video_pipe" [label="video.render_pipe\nvideo_pipe",color="#8BE0D1"];
  "audio_bed" [label="audio.synthesize\naudio_bed",color="#8BE0D1"];
  "encode" [label="video.encode\nencode",color="#8BE0D1"];
  "mux" [label="media.mux\nmux",color="#8BE0D1"];
  "reference_measure" [label="reference.spatial_extract\nreference_measure",color="#8BE0D1"];
  "qa_full_video" [label="qa.av_probe\nqa_full_video",color="#8BE0D1"];
  "package" [label="asset.package\npackage",color="#8BE0D1"];
  "motion_inference" [label="motion.ai_articulation\nmotion_inference",color="#ADB4C4"];
  "subject_tracking" [label="layout.subject_tracking\nsubject_tracking",color="#ADB4C4"];
  "beat_automation" [label="beat.story_and_motion\nbeat_automation",color="#ADB4C4"];
  "human_review" [label="qa.editorial\nhuman_review",color="#F4A9AA"];
  "timeline" -> "canvas";
  "canvas" -> "safe_zone";
  "source_rights" -> "scene_assets";
  "timeline" -> "scene_assets";
  "timeline" -> "camera";
  "canvas" -> "camera";
  "scene_assets" -> "background";
  "camera" -> "background";
  "background" -> "props";
  "camera" -> "props";
  "props" -> "character";
  "timeline" -> "character";
