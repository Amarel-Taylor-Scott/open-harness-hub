  "camera" -> "video_pipe";
  "timeline" -> "audio_bed";
  "video_pipe" -> "encode";
  "encode" -> "mux";
  "audio_bed" -> "mux";
  "mux" -> "reference_measure";
  "mux" -> "qa_full_video";
  "layout_qa" -> "qa_full_video";
  "qa_full_video" -> "package";
  "reference_measure" -> "package";
  "source_rights" -> "package";
  "scene_assets" -> "motion_inference";
  "frame_crop" -> "subject_tracking";
  "timeline" -> "beat_automation";
  "reference_measure" -> "beat_automation";
