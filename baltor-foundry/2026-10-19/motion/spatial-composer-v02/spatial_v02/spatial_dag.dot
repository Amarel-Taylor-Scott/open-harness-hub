  "foreground" -> "atmosphere";
  "timeline" -> "atmosphere";
  "atmosphere" -> "color_grade";
  "color_grade" -> "frame_crop";
  "camera" -> "frame_crop";
  "timeline" -> "shot_style";
  "frame_crop" -> "safe_candidate";
  "safe_zone" -> "safe_candidate";
  "shot_style" -> "anchor_solver";
  "safe_zone" -> "anchor_solver";
  "anchor_solver" -> "padding";
  "padding" -> "text_fit";
  "shot_style" -> "text_fit";
  "timeline" -> "timing";
  "shot_style" -> "timing";
  "anchor_solver" -> "shape_layers";
  "timing" -> "shape_layers";
  "text_fit" -> "text_layers";
  "timing" -> "text_layers";
  "frame_crop" -> "image_layers";
